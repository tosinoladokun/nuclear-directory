<% content_for :title, "Edit #{@fact.name}" %>
<% pending = @fact.verification_status == "pending" %>

<div class="nd-stack max-w-prose">
  <% trail = [ [ "Live", related_context[:live] ], [ related_context[:name], next_or(related_context[:path]) ], [ @fact.name.to_s.upcase_first, record_path_here ] ] if related_context %>
  <%= render "admin/crumbs", parent_label: @fact.name.to_s.upcase_first, parent_path: next_or(record_path_here), trail:, current: "Edit" %>
  <h1 class="type-admin-h1 m-0">Edit <%= @fact.name %></h1>

  <%= form_with url: record_path_here, method: :patch, class: "nd-stack" do |form| %>
    <%# Back to where Edit was opened (a related row on a Record), else this page. %>
    <%= hidden_field_tag :next, params[:next], id: nil if next_or(nil) %>
    <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
    <% if @errors.present? %>
      <div class="nd-alert" role="alert">
        <p class="type-body-strong">Not saved. Fix this and save again:</p>
        <ul class="type-body"><% @errors.each do |error| %><li><%= error.upcase_first %></li><% end %></ul>
      </div>
    <% end %>
    <% @fields.each do |name| %>
      <% value = params.dig(:values, name) || @fact.values[name] %>
      <% if name == "short_description" %>
        <%# #559: 40 characters, one line on a phone; the row it makes, live. %>
        <div class="nd-field" data-controller="short-description" data-short-description-max-value="<%= ShortDescription::MAX %>" data-short-description-width-value="330">
          <%= label_tag "values_#{name}", field_label(name), class: "type-body-strong" %>
          <%= text_field_tag "values[#{name}]", value, id: "values_#{name}", class: "nd-input type-input", maxlength: ShortDescription::MAX,
            aria: { describedby: "short-description-count" }, data: { short_description_target: "input", action: "input->short-description#update" } %>
          <p id="short-description-count" class="type-small text-ink-muted m-0" aria-live="polite" data-short-description-target="count"><%= ShortDescription::MAX - value.to_s.length %> left</p>
          <p class="type-small m-0"><span class="type-body-strong"><%= @fact.name %></span> · <span data-short-description-target="preview"><%= value.presence || "Role · specialty until it's written" %></span></p>
        </div>
      <% else %>
      <div class="nd-field">
        <%= label_tag "values_#{name}", field_label(name), class: "type-body-strong" %>
        <%= text_field_tag "values[#{name}]", value, id: "values_#{name}", class: "nd-input type-input" %>
      </div>
      <% end %>
    <% end %>
    <div class="nd-field">
      <label for="note" class="type-body-strong">What you changed and why <span class="type-small text-ink-muted">(optional, kept in the history)</span></label>
      <%= text_field_tag :note, params[:note], class: "nd-input type-input" %>
    </div>
    <div class="nd-row">
      <%= form.submit(pending ? "Save and approve" : "Save", class: "nd-btn nd-btn--primary") %>
      <%= link_to "Cancel", next_or(record_path_here), class: "nd-btn nd-btn--outline" %>
    </div>
  <% end %>
</div>
