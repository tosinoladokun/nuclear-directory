<% content_for :title, "Overview" %>
<% counts = admin_nav_counts %>

<div class="nd-shell__head nd-shell__head--date">
  <h1 class="type-admin-h1">Overview</h1>
  <span class="type-kicker text-ink-muted"><%= Date.current.strftime("%-d %b") %></span>
</div>

<section class="nd-tiles nd-tiles--stages" aria-label="Stages">
  <%= link_to admin_sources_path, class: "nd-tile" do %><span class="type-stage text-ink-muted max-md:text-ink">Sources</span> <span class="type-tile"><%= counts[:sources] %></span><% end %>
  <%= link_to admin_checks_path, class: "nd-tile nd-tile--ink" do %><span class="type-stage text-on-inverse opacity-70 max-md:opacity-100">Checks · waiting</span> <span class="type-tile"><%= number_with_delimiter(counts[:checks]) %></span><% end %>
  <%= link_to admin_live_path, class: "nd-tile" do %><span class="type-stage text-ink-muted max-md:text-ink">Live</span> <span class="type-tile"><%= number_with_delimiter(counts[:live]) %></span><% end %>
  <%= link_to admin_corrections_path, class: "nd-tile", title: "From visitors" do %><span class="type-stage text-ink-muted max-md:text-ink">Correction requests</span> <span class="type-tile"><%= counts[:corrections] %></span><% end %>
</section>


<%= render "admin/overview/health" %>
