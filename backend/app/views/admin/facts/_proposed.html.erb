<%# What the claim being decided proposes (#269), beside the fact as stored.
    A changed value: only the fields it changes, old → new (old and arrow
    muted, new in strong). A new link or fact: all its values. Then the
    quote and source behind it. Locals: item (DataQuality::Review::Item). %>
<% source_url = safe_url(item.source.url) %>
<%# A changed value's rows come from its differences, which can name a field
    worked out from the claim (a website's domain) rather than one it carries. %>
<% shown = item.differences.any? ? item.differences : item.payload.except(*DataQuality::Review::LINK_ENDS, "identify").compact_blank %>
<section class="nd-panel" id="proposed" aria-label="Proposed by this claim">
  <div class="nd-kick"><span class="type-kicker text-ink-muted"><%= claim_number(item.candidate_id) %></span><p class="type-kicker text-ink-muted m-0"><%= check_kicker(item) %></p></div>
  <p class="type-body"><%= claim_text(item) %></p>
  <% if shown.any? %>
    <dl class="nd-kv type-body">
      <% shown.each do |name, value| %>
        <dt class="type-label"><%= field_label(name) %></dt>
        <dd>
          <% if (difference = item.differences[name]) %>
            <span class="text-ink-muted"><%= difference.first.presence || "Not set" %> →</span> <span class="type-body-strong"><%= difference.last.presence || "Not set" %></span>
          <% else %>
            <%= field_display(name, value) %>
          <% end %>
        </dd>
      <% end %>
    </dl>
  <% end %>
  <% if item.quote.present? %><blockquote class="nd-quote">“<%= item.quote %>”</blockquote><% end %>
  <p class="type-small text-ink-muted">
    <% if source_url %>
      <%= link_to source_url, class: "nd-link nd-link--muted", target: "_blank", rel: "noopener" do %><%= item.source.title.presence || source_host(source_url) %> <%= icon("arrow-square-out", size: 12) %><% end %>
    <% else %>
      <%= item.source.title.presence || item.source.url %>
    <% end %>
  </p>
</section>
