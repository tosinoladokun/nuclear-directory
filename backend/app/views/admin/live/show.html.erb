<% content_for :title, "Live" %>
<% list = @list %>

<div class="nd-shell__head">
  <h1 class="type-admin-h1">Live <span class="type-count"><%= number_with_delimiter(list.total) %></span></h1>
  <%= link_to "Add a record", admin_new_record_path(back: request.fullpath), class: "nd-btn nd-btn--primary type-ui" %>
</div>

<div class="nd-live__bar">
  <nav class="nd-fchips type-ui" aria-label="Record type">
    <% Directory::LiveList::TAB_LABELS.each do |tab, label| %>
      <%= link_to live_path_for(list, tab:), class: "nd-fchip nd-fchip--tab", aria: { current: ("page" if tab == list.tab) } do %><%= label %> <span class="type-data nd-num"><%= number_with_delimiter(@tab_counts[tab]) %></span><% end %>
    <% end %>
  </nav>
  <%= form_with url: admin_live_path, method: :get, class: "nd-live__search", role: "search" do %>
    <%= hidden_field_tag :tab, list.tab, id: nil unless list.tab == "all" %>
    <%= hidden_field_tag :within, list.within, id: nil if list.within %>
    <% list.chosen.each do |group, keys| %>
      <% next if keys.empty? || (group == "status" && keys == [ Directory::LiveList::DEFAULT_STATUS ]) %>
      <%= hidden_field_tag group, keys.join(","), id: nil %>
    <% end %>
    <label class="sr-only" for="live-q">Search</label>
    <input type="search" id="live-q" name="q" value="<%= list.query %>" placeholder="Search" class="nd-input type-input">
  <% end %>
</div>

<% if list.within %>
  <%# Opened from Sources: only what that source (or document) backs. %>
  <p class="nd-fchips type-ui">
    <%= link_to live_path_for(list, without_source: true), class: "nd-fchip", aria: { current: "true" }, title: "Show every source" do %>From: <%= SourceCatalog.label(list.within) %> <span aria-hidden="true">×</span><% end %>
  </p>
<% end %>

<%# The filters: one row per group of tags. On phones, behind "Filters (N)". %>
<% chosen_count = list.chosen.sum { |group, keys| group == "status" ? (keys == [ Directory::LiveList::DEFAULT_STATUS ] ? 0 : 1) : keys.size } %>
<details class="nd-live__filters" open data-controller="live-filters">
  <summary class="nd-btn nd-btn--outline type-ui">Filters<%= " (#{chosen_count})" if chosen_count.positive? %></summary>
  <section class="nd-panel nd-live__groups" aria-label="Filters">
    <% Directory::Checks::GROUPS.each do |group, label| %>
      <div class="nd-live__group">
        <span class="type-kicker text-ink-muted"><%= label %></span>
        <div class="nd-fchips type-ui">
          <% Directory::Checks.in_group(group).each do |tag| %>
            <% count = list.count(tag.key) %>
            <%= link_to live_path_for(list, toggle: tag.key), class: [ "nd-fchip", ("nd-fchip--zero" if count.zero?) ].compact.join(" "),
              title: tag.hint, aria: { current: (list.chosen?(tag.key) ? "true" : nil) }, rel: "nofollow" do %><%= tag.label %> <span class="type-data nd-num"><%= number_with_delimiter(count) %></span><% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="nd-live__foot">
      <span class="type-data text-ink-muted">Showing <%= number_with_delimiter(list.total) %> <%= list.nouns[list.total == 1 ? 0 : 1] %></span>
      <% if list.filtered? %><%= link_to "Clear all", live_path_for(list, clear: true), class: "nd-link type-ui" %><% end %>
    </div>
  </section>
</details>

<% if @rows.empty? %>
  <p class="type-body text-ink-muted">Nothing matches. <%= link_to "Clear all", live_path_for(list, clear: true), class: "nd-link" if list.filtered? %></p>
<% else %>
  <div class="overflow-x-auto">
    <table class="nd-numtable nd-live__table">
      <thead><tr><th scope="col">Name</th><th scope="col">Type</th><th scope="col">Flags</th><th scope="col">Changed</th></tr></thead>
      <tbody>
        <% @rows.each do |row| %>
          <tr id="row-<%= row.type %>-<%= row.id %>">
            <td class="type-body"><%= link_to row.name, live_row_path(row, request.fullpath), class: "nd-link" %></td>
            <td class="type-body"><%= row.kind %><% unless row.status == "Live" %> <span class="text-ink-muted">· <%= row.status %></span><% end %></td>
            <td class="type-data"><%= row.flags.join(" · ") %></td>
            <td class="type-data text-ink-muted"><%= row.changed_at.strftime("%-d %b") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% pages = (list.total / Directory::LiveList::PAGE.to_f).ceil %>
  <% if pages > 1 %>
    <nav class="nd-itemnav type-ui" aria-label="Pages">
      <% if @page > 1 %><%= link_to "‹ Previous", request.query_parameters.merge(page: @page - 1), class: "nd-btn nd-btn--ghost nd-btn--sm", rel: "prev" %><% end %>
      <span class="type-data text-ink-muted">Page <%= @page %> of <%= pages %></span>
      <% if @page < pages %><%= link_to "Next ›", request.query_parameters.merge(page: @page + 1), class: "nd-btn nd-btn--ghost nd-btn--sm", rel: "next" %><% end %>
    </nav>
  <% end %>
<% end %>
