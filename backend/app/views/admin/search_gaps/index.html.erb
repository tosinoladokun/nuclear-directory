<% content_for :title, "Search gaps" %>

<div class="nd-stack">
  <div class="nd-shell__head">
    <h1 class="type-admin-h1">Search gaps <span class="type-count"><%= number_with_delimiter(@waiting.size) %></span></h1>
  </div>
  <p class="type-body m-0">What visitors searched for on the site and didn't find, most searched first. Only the words searched are kept, never who searched. A gap closes on its own once the same search finds something.</p>

  <% if @waiting.empty? %>
    <p class="type-body text-ink-muted">No open gaps.</p>
  <% else %>
    <ol class="nd-waits nd-searchgaps">
      <% @waiting.each do |gap| %>
        <li class="nd-wait" id="gap-<%= gap.id %>">
          <div class="nd-wait__what">
            <p class="type-subject m-0"><%= link_to gap.query, companies_path(q: gap.query), class: "nd-link", target: "_blank", rel: "noopener" %></p>
            <p class="type-small text-ink-muted m-0"><%= pluralize(gap.searches_count, "search") %> · last <%= gap.last_searched_on.strftime("%-d %b") %><% if gap.status_research? %> · <span class="nd-tag">To research</span><% end %></p>
          </div>
          <div class="nd-wait__actions nd-searchgaps__actions type-ui">
            <% SearchGap::DECISIONS.each do |status, label| %>
              <% next if status == "research" && gap.status_research? %>
              <%= button_to label, admin_search_gap_decide_path(id: gap.id, decision: status), class: "nd-btn nd-btn--outline", "aria-label": "#{label}: #{gap.query}" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>
  <% end %>

  <% if @decided.any? %>
    <details class="nd-fold">
      <summary class="type-body">Covered, ignored or found since <span class="type-data nd-num"><%= @decided.size %></span></summary>
      <div class="nd-fold__body">
        <% @decided.each do |gap| %>
          <p class="nd-fold__row type-body"><span><%= gap.query %></span>
            <span class="type-small text-ink-muted"><%= { "covered" => "Covered", "ignored" => "Ignored", "closed" => "Finds a result now" }.fetch(gap.status) %> · <%= pluralize(gap.searches_count, "search") %></span></p>
        <% end %>
      </div>
    </details>
  <% end %>
</div>
