<% content_for :title, @entry.name %>
<% research = @entry.kind.nil? %>
<% status_label = ->(status) { { "pending" => research ? "Not checked by the crawler" : "Not read yet", "ok" => "OK", "blocked" => "Blocked", "needs_human" => "Needs a person" }.fetch(status) } %>

<%= render "admin/crumbs", parent_label: "Sources", parent_path: back_path(admin_sources_path), current: @entry.name %>
<h1 class="type-admin-h1">
  <%= @entry.name %> <span class="type-count"><%= number_with_delimiter(@entry.documents) %></span>
  <% if @entry.note %><span class="type-data text-ink-muted"><%= @entry.note %></span><% end %>
</h1>

<nav class="nd-fchips type-ui" aria-label="Status">
  <%= link_to admin_source_path(key: @entry.key, back: back_path(nil)), class: "nd-fchip", aria: { current: ("page" unless @status) } do %>All <span class="type-data nd-num"><%= number_with_delimiter(@entry.documents) %></span><% end %>
  <% Admin::SourcesController::STATUS_CHIPS.each do |status| %>
    <%= link_to admin_source_path(key: @entry.key, status:, back: back_path(nil)), class: "nd-fchip", aria: { current: ("page" if status == @status) } do %><%= status_label.(status) %> <span class="type-data nd-num"><%= @counts[status] %></span><% end %>
  <% end %>
</nav>

<% if @documents.empty? %>
  <p class="type-body text-ink-muted">None.</p>
<% else %>
  <div class="overflow-x-auto">
    <table class="nd-numtable nd-stack-table nd-sources">
      <thead><tr><th scope="col">Document</th><th scope="col">Facts</th><th scope="col">Last read</th><th scope="col" class="nd-l">Status</th></tr></thead>
      <% if research %>
        <%# One collapsible row per domain, most documents first; the newest document's domain starts open. %>
        <% by_domain = @documents.group_by(&:domain).sort_by { |domain, documents| [ -documents.size, domain.to_s ] } %>
        <% newest = @documents.max_by(&:id)&.domain %>
        <% by_domain.each do |domain, documents| %>
          <tbody class="nd-sources__domain" data-controller="domain-rows" data-domain-rows-open-value="<%= domain == newest %>">
            <tr class="nd-sources__group">
              <td colspan="4">
                <button type="button" class="nd-sources__toggle type-body-strong" aria-expanded="<%= domain == newest %>" data-action="domain-rows#toggle">
                  <%= domain %> <span class="type-data text-ink-muted"><%= documents.size %></span>
                </button>
              </td>
            </tr>
            <% documents.each do |document| %>
              <%= render "admin/sources/document", document: %>
            <% end %>
          </tbody>
        <% end %>
      <% else %>
        <tbody>
          <% @documents.each do |document| %>
            <%= render "admin/sources/document", document: %>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>
<% end %>

<% failure = SourceCatalog.failure(@entry.kind) %>
<% if @runs.present? || failure %>
  <section class="nd-panel" aria-label="Last runs">
    <p class="type-kicker text-ink-muted">Last run</p>
    <% if failure %>
      <p class="type-data">The last read failed at <%= failure.started_at.strftime("%-d %b %H:%M") %><% if failure.error.present? %><span class="text-ink-muted"> · <%= failure.error.truncate(200) %></span><% end %></p>
      <% if @runs.present? %><p class="type-kicker text-ink-muted">Earlier run</p><% end %>
    <% end %>
    <% last = @runs&.first %>
    <% if last && failure&.id != last.id %>
      <% if last.status == "failed" %>
        <p class="type-data">Failed<% if last.error.present? %><span class="text-ink-muted"> · <%= last.error.truncate(200) %></span><% end %></p>
      <% else %>
        <p class="type-data">Read <%= last.stats["candidates"].to_i %> · Same <%= last.stats["confirmed"].to_i %> · Changed <%= last.stats["candidates"].to_i - last.stats["confirmed"].to_i %></p>
      <% end %>
    <% end %>
    <% if @runs.present? %>
    <table class="nd-numtable">
      <thead><tr><th scope="col">Run</th><th scope="col">Read</th><th scope="col">Same</th><th scope="col">Changed</th></tr></thead>
      <tbody>
        <% @runs.each do |run| %>
          <tr>
            <td class="type-data"><%= run.started_at.strftime("%-d %b %H:%M") %></td>
            <% if run.status == "failed" %>
              <td colspan="3" class="type-body">Failed<% if run.error.present? %><span class="text-ink-muted"> · <%= run.error.truncate(120) %></span><% end %></td>
            <% else %>
              <td class="type-cell-num"><%= run.stats["candidates"].to_i %></td><td class="type-cell-num"><%= run.stats["confirmed"].to_i %></td><td class="type-cell-num"><%= run.stats["candidates"].to_i - run.stats["confirmed"].to_i %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% end %>
  </section>
<% end %>
