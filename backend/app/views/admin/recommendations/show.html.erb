<% content_for :title, "Data Quality's recommendations" %>
<%
  # A fact page decides the claims waiting on it (recommended or needing review); any other claim is decided on its own page.
  claim_path = ->(item) do
    item.subject_id && item.waiting ? admin_fact_path(type: item.subject_type, id: item.subject_id, claim: item.candidate_id, from: "checks", back: admin_recommendations_path) :
      edit_admin_candidate_path(item.candidate_id, back: admin_recommendations_path)
  end
  call_word = { "approve" => "Approve", "reject" => "Reject" }
%>

<div class="nd-stack">
  <%= render "admin/crumbs", parent_label: "Checks", parent_path: admin_checks_path, current: "Data Quality's recommendations" %>
  <h1 class="type-admin-h1 m-0">Data Quality's recommendations</h1>

  <% if @errors.present? %>
    <div class="nd-alert" role="alert">
      <p class="type-body-strong">
        <%= @recorded.to_i.positive? ? "Added #{pluralize(@recorded, 'recommendation')}." : "No recommendations added." %>
        <%= @errors.one? ? "1 line wasn't added:" : "#{@errors.size} lines weren't added:" %>
      </p>
      <ul class="type-body">
        <% @errors.each do |error| %>
          <li><q><%= error.text %></q><br><span class="type-small text-ink-muted">Line <%= error.line %>: <%= error.problem %></span></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="nd-stack" aria-labelledby="accept-heading">
    <div class="nd-shell__head">
      <h2 class="type-admin-h2 m-0" id="accept-heading">To accept <span class="type-count"><%= @plan.accept.size %></span></h2>
      <% if @plan.accept.any? %>
        <% approvals, rejections = @plan.accept.partition { |item| item.call == "approve" }.map(&:size) %>
        <% label = "Accept: #{[ ("approve #{approvals}" if approvals.positive?), ("reject #{rejections}" if rejections.positive?) ].compact.join(', ')}" %>
        <div class="nd-recs__accept">
          <p class="type-small text-ink-muted m-0">Each is recorded as yours, with Data Quality's reason.</p>
          <%= button_to label, admin_recommendations_accept_path, params: { shown: @plan.fingerprint },
            class: "nd-btn nd-btn--primary type-ui",
            form: { data: { turbo_confirm: "#{label}? Approvals publish, and each is checked again as it's decided." } } %>
        </div>
      <% end %>
    </div>
    <% if @plan.accept.empty? %>
      <p class="type-body text-ink-muted">Nothing to accept. Paste Data Quality's list below.</p>
    <% else %>
      <table class="nd-numtable nd-stack-table nd-recs">
        <thead><tr><th scope="col">Claim</th><th scope="col" class="nd-l">Decision</th><th scope="col" class="nd-l">Data Quality's reason</th></tr></thead>
        <tbody>
          <% @plan.accept.each do |item| %>
            <tr id="rec-<%= item.candidate_id %>">
              <td class="type-body nd-l"><%= link_to item.claim.to_s.upcase_first, claim_path.(item), class: "nd-link" %> <span class="type-data-sm text-ink-muted">Claim <%= item.candidate_id %></span></td>
              <td class="type-body-strong nd-l"><%= call_word.fetch(item.call) %></td>
              <td class="type-body nd-l"><%= item.reason %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <% if @plan.left.any? %>
    <section class="nd-stack" aria-labelledby="left-heading">
      <h2 class="type-admin-h2 m-0" id="left-heading">Left for you <span class="type-count"><%= @plan.left.size %></span></h2>
      <p class="type-body text-ink-muted m-0">Data Quality recommended these, but Accept won't decide them. Open each to decide it yourself.</p>
      <table class="nd-numtable nd-stack-table nd-recs">
        <thead><tr><th scope="col">Claim</th><th scope="col" class="nd-l">Data Quality says</th><th scope="col" class="nd-l">Why it's left</th></tr></thead>
        <tbody>
          <% @plan.left.each do |item| %>
            <tr id="rec-<%= item.candidate_id %>">
              <td class="type-body nd-l"><%= link_to item.claim.to_s.upcase_first, claim_path.(item), class: "nd-link" %> <span class="type-data-sm text-ink-muted">Claim <%= item.candidate_id %></span></td>
              <td class="type-body nd-l"><strong><%= call_word.fetch(item.call) %>:</strong> <%= item.reason %></td>
              <td class="type-body text-ink-muted nd-l"><span class="nd-recs__label">Left because: </span><%= item.why.upcase_first %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
  <% end %>

  <details class="nd-fold" <%= "open" if @plan.accept.empty? && @plan.left.empty? || @errors.present? %>>
    <summary class="type-body">Paste Data Quality's list</summary>
    <%= form_with url: admin_recommendations_path, class: "nd-fold__body nd-stack" do %>
      <div class="nd-field">
        <label for="list" class="type-body-strong">One claim a line</label>
        <p class="nd-field__hint type-small" id="list-hint">“1234 approve: reason” or “1234 reject: reason”. Lines starting with # are skipped. Adding the list decides nothing.</p>
        <%# Kept only when a line needs fixing; once added, the box is empty for the next list. %>
        <%= text_area_tag :list, (params[:list] if @errors.present?), class: "nd-input type-input", rows: 8, required: true, aria: { describedby: "list-hint" } %>
      </div>
      <div><button type="submit" class="nd-btn nd-btn--outline type-ui">Add the list</button></div>
    <% end %>
  </details>
</div>
