<% content_for :title, "Today" %>
<% sections = @inbox.sections %>
<% total = @inbox.size %>
<% checked = @inbox.checked %>
<%# Data Quality's no on any claim shown (#777), read once for the page: id => reason. %>
<% said_no = Candidate.where(id: sections.values.flatten.flat_map(&:ids), dq_recommendation: "reject").pluck(:id, :dq_reason).to_h %>
<% headings = { "new_record" => "New companies and plants", "new_fact" => "New facts and deals", "change" => "Changes to something you decided" } %>
<%# One checked item needs no batch button: its own Yes does it (Design). %>
<% batch_after = (%w[new_record new_fact change].find { |key| sections[key].any? { |entry| checked.include?(entry) } } if checked.size > 1) %>

<% if flash[:undo] %>
  <% content_for :flash_action do %>
    <%= button_to "Undo", admin_inbox_undo_path, params: { token: flash[:undo] }, class: "nd-link nd-flash__action type-body", form_class: "nd-flash__undo" %>
  <% end %>
<% end %>
<div>
  <h1 class="type-admin-h1">Today</h1>
  <p class="type-body m-0"><%= total.zero? ? "Nothing to decide today." : "#{total} to decide. Nothing goes live until you say yes." %></p>
</div>

<%# The social agent switched itself off (#769): said here, where he looks every day. %>
<% SocialChannel.where.not(paused_reason: nil).each do |channel| %>
  <p class="nd-flash type-body" role="alert" id="social-paused-<%= channel.platform %>">Posting to <%= channel.platform == "x" ? "X" : "LinkedIn" %> stopped: <%= channel.paused_reason %>. <%= link_to "Check Posts", admin_social_path, class: "nd-link" %></p>
<% end %>
<%= form_with url: admin_inbox_suggest_path, class: "nd-stack", aria: { label: "Add a lead" } do %>
  <%= label_tag :suggestion, "Add a lead", class: "type-admin-h2 m-0" %>
  <%= text_area_tag :suggestion, nil, class: "nd-input type-input", rows: 2, required: true,
        placeholder: "A company name, website or link. One per line for several." %>
  <div><%= submit_tag "Add", class: "nd-btn type-ui", name: nil %></div>
<% end %>

<%# One line each while it's in the pipeline; once Tosin decides it, it's in Recently decided instead. %>
<% leads = CompanySuggestion.shown.to_a.reject { |lead| %w[Created Said\ no].include?(LeadFinding.state(lead)) } %>
<% if leads.any? %>
  <section class="nd-stack" aria-labelledby="inbox-leads">
    <h2 id="inbox-leads" class="type-admin-h2 m-0">Your leads <span class="type-count"><%= leads.size %></span></h2>
    <ul class="nd-stack m-0 p-0 list-none">
      <% leads.each do |lead| %>
        <% state = LeadFinding.state(lead) %>
        <li class="nd-inbox__recent" id="lead-<%= lead.id %>">
          <span class="type-body-strong"><%= lead.name %></span>
          <span class="type-body"><%= state %><%= ": #{lead.note.delete_prefix(LeadFinding::UNCONFIRMED).delete_prefix(': ')}" if state == "Couldn't confirm" && lead.note.to_s.length > LeadFinding::UNCONFIRMED.length %></span>
          <% if state == "In your inbox" %><%= link_to "Show", "#inbox-item-#{lead.candidate_id}", class: "nd-link type-small whitespace-nowrap" %><% end %>
          <% if lead.record && state == "Already listed" %><%= link_to "Open it", admin_fact_path(type: lead.record_type, id: lead.record_id), class: "nd-link type-small whitespace-nowrap" %><% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%# Data Quality's take-off proposals (#863): one set per batch, Yes takes off (reversible), No keeps. %>
<% takeoffs = TakeoffProposal.pending.order(:id).group_by(&:batch) %>
<% if takeoffs.any? %>
  <section class="nd-stack" aria-labelledby="inbox-takeoffs">
    <h2 id="inbox-takeoffs" class="type-admin-h2 m-0">Take off what's wrong <span class="type-count"><%= takeoffs.values.sum(&:size) %></span></h2>
    <% takeoffs.each do |batch, proposals| %>
      <div class="nd-stack" id="takeoff-set-<%= batch %>">
        <ol class="nd-waits">
          <% proposals.each do |proposal| %>
            <% subject = proposal.subject %>
            <li class="nd-inbox__recent" id="takeoff-<%= proposal.id %>">
              <span class="type-body-strong"><%= subject ? link_to(subject.try(:name) || subject.try(:display_title) || "#{type_label(proposal.subject_type)} #{proposal.subject_id}", admin_fact_path(type: proposal.subject_type, id: proposal.subject_id), class: "nd-link") : "#{proposal.subject_type} #{proposal.subject_id}" %></span>
              <span class="type-body"><%= proposal.reason %><% if proposal.source_url %> · <%= link_to "Source", proposal.source_url, class: "nd-link", target: "_blank", rel: "noopener" %><% end %></span>
              <span class="nd-row">
                <%= button_to "Take off", admin_inbox_decide_takeoff_path(id: proposal.id, decision: "yes"), class: "nd-btn nd-btn--primary type-ui" %>
                <%= button_to "Keep", admin_inbox_decide_takeoff_path(id: proposal.id, decision: "no"), class: "nd-btn nd-btn--outline type-ui" %>
              </span>
            </li>
          <% end %>
        </ol>
        <% if proposals.size > 1 %>
          <div class="nd-row">
            <%= button_to "Take off all #{proposals.size}", admin_inbox_decide_takeoff_set_path(batch:, decision: "yes"), class: "nd-btn nd-btn--primary type-ui" %>
            <%= button_to "Keep all", admin_inbox_decide_takeoff_set_path(batch:, decision: "no"), class: "nd-btn nd-btn--outline type-ui" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>

<div class="nd-stack" data-controller="bulk-select">
<%# Tick rows, then decide them together (#771). The boxes sit in each row and belong to this form. %>
<%= form_with url: admin_inbox_decide_selected_path, id: "inbox-selected", class: "nd-row nd-inbox__bulk", data: { bulk_select_target: "bar" }, hidden: true do |form| %>
  <%= form.button name: "decision", value: "yes", class: "nd-btn nd-btn--primary type-ui" do %><span>Create / Approve selected (<span data-bulk-select-target="count">0</span>)</span><% end %>
  <%= form.button name: "decision", value: "no", class: "nd-btn nd-btn--outline type-ui" do %><span>No to selected (<span data-bulk-select-target="count">0</span>)</span><% end %>
<% end %>
<% OwnerInbox::SECTIONS.each do |key| %>
  <% entries = sections[key] %>
  <% records = key == "new_record" ? @inbox.records : [] %>
  <% waiting = key == "new_record" ? @inbox.companies_waiting : 0 %>
  <% next if entries.empty? && records.empty? && waiting.zero? %>
  <section class="nd-stack" aria-labelledby="inbox-<%= key %>">
    <h2 id="inbox-<%= key %>" class="type-admin-h2 m-0"><%= headings.fetch(key) %> <span class="type-count"><%= entries.size + records.size %></span></h2>
    <label class="nd-row type-small"><input type="checkbox" class="nd-check" data-action="bulk-select#all" data-section="<%= key %>"> Select all</label>
    <% if waiting.positive? %>
      <p class="type-small text-ink-muted m-0"><%= pluralize(waiting, "more new company", plural: "more new companies") %> tomorrow. <%= OwnerInbox::CREATES_A_DAY %> a day, best-sourced first.</p>
    <% end %>
    <ol class="nd-waits">
      <% entries.each do |entry| %>
        <% item = entry.item %>
        <li class="nd-wait nd-inbox__item" id="inbox-item-<%= item.candidate_id %>">
          <%# Data Quality said no: decided on its own row only (DQ, 12 Nov). %>
          <% if entry.ids.any? { |id| said_no.key?(id) } %>
            <span class="nd-check" aria-hidden="true"></span>
          <% else %>
            <input type="checkbox" class="nd-check" name="selected[]" value="claim:<%= entry.ids.join(",") %>" form="inbox-selected" data-section="<%= key %>"
              data-bulk-select-target="box" data-action="click->bulk-select#pick" aria-label="Select #<%= item.candidate_id %>">
          <% end %>
          <div class="nd-wait__what">
            <% if key == "new_record" %>
              <p class="m-0"><span class="nd-tag"><%= item.kind == "facility" ? "Plant" : "Company" %></span></p>
            <% end %>
            <% if key == "change" %>
              <%# Design: the record named, then each field old → new; with none to show, what approving does. %>
              <% if entry.changes.empty? %>
                <p class="type-body-strong m-0"><%= claim_text(item) %></p>
              <% end %>
              <% entry.changes.each do |field, (stored, stated)| %>
                <p class="type-body-strong m-0"><%= item.record&.name || item.payload.to_h["name"] %> · <%= field_label(field).upcase_first %>:
                  <s class="text-ink-muted"><%= field_display(field, stored) %></s> → <%= field_display(field, stated) %></p>
              <% end %>
            <% else %>
              <p class="<%= key == "new_record" ? "type-body" : "type-body-strong" %> m-0"><%= inbox_sentence(entry) %></p>
              <% if key == "new_record" && (item.payload.to_h.keys - %w[name aliases]).empty? %>
                <%# Only a name: the source's words say what it is (Design). %>
                <p class="type-small text-ink-muted m-0">“<%= item.quote %>”</p>
              <% end %>
            <% end %>
            <% if (no = entry.ids.select { |id| said_no.key?(id) }.map { |id| said_no[id] }).any? %>
              <p class="type-small m-0 text-critical" id="dq-no-<%= item.candidate_id %>"><strong>Data Quality says no:</strong> <%= no.compact.first || "no reason given" %></p>
            <% end %>
            <p class="type-small m-0">
              <% if (url = safe_url(item.source&.url)) %><%= link_to url, class: "nd-link whitespace-nowrap", target: "_blank", rel: "noopener" do %><%= source_host(url) %> <%= icon("arrow-square-out", size: 12) %><% end %> · <% end %>
              <span class="nd-num">#<%= item.candidate_id %></span>
            </p>
            <details class="nd-fold">
              <summary class="type-small">Why, and the source</summary>
              <div class="nd-fold__body nd-stack">
                <blockquote class="nd-quote m-0">“<%= item.quote %>”</blockquote>
                <%# What else goes with this Create: each field from its own source (#760), and the company's other checked
                    claims, such as its website from its own page (one Create per company, 11 Nov). %>
                <% if key == "new_record" %>
                  <% Candidate.where(id: entry.copy_ids).includes(:source).order(:id).reject { |c| c.payload.except(*DataQuality::FieldEvidence::KEYS) == item.payload.to_h }.each do |field| %>
                    <%# A role from its own page shows as its name (#811). %>
                    <% values = if field.kind == "organization_role"
                         { "role" => (@role_names ||= Role.pluck(:key, :name).to_h)[field.payload["role"]] || field.payload["role"] }
                       else
                         field.payload.except("name", "aliases", *DataQuality::FieldEvidence::KEYS)
                       end %>
                    <% next if values.empty? %>
                    <div class="nd-stack" id="<%= field.payload["field_of"] ? "field-claim" : "also-claim" %>-<%= field.id %>">
                      <p class="type-small m-0"><strong><%= values.map { |name, value| "#{DataQuality::Claim::LABELS.fetch(name, name.humanize).upcase_first}: #{value}" }.join(", ") %></strong>
                        <% if (url = safe_url(field.source&.url)) %> · <%= link_to source_host(url), url, class: "nd-link", target: "_blank", rel: "noopener" %><% end %></p>
                      <blockquote class="nd-quote m-0">“<%= field.quote %>”</blockquote>
                    </div>
                  <% end %>
                <% end %>
                <%# The checker's doubt and Data Quality's reason, side by side (PM, 27 Oct). %>
                <% if item.ai_recommendation.present? && item.ai_recommendation != "recommend_publish" && item.ai_reason.present? %>
                  <p class="type-small m-0"><strong>The checker wasn't sure:</strong> <%= item.ai_reason %></p>
                <% end %>
                <% if item.dq_recommendation == "approve" && item.dq_reason.present? %>
                  <p class="type-small m-0"><strong>Data Quality checked it:</strong> <%= item.dq_reason %></p>
                <% end %>
              </div>
            </details>
          </div>
          <div class="nd-wait__actions nd-inbox__buttons type-ui">
            <% yes, no = key == "change" ? [ "Approve the change", nil ] : [ key == "new_record" ? "Create" : "Approve", "No" ] %>
            <% row_said_no = entry.ids.any? { |id| said_no.key?(id) } %>
            <%= button_to yes, admin_inbox_decide_path(item.candidate_id, "yes"), params: { ids: entry.ids }, class: "nd-btn nd-btn--primary",
              data: (row_said_no ? { turbo_confirm: "Data Quality says no to this. #{yes} anyway?" } : {}) %>
            <% if key == "change" %>
              <%= button_to admin_inbox_decide_path(item.candidate_id, "no"), params: { ids: entry.ids, kind: "change" }, class: "nd-btn nd-btn--outline" do %><span class="nd-inbox__long">Keep what I decided</span><span class="nd-inbox__short">Keep mine</span><% end %>
            <% else %>
              <%= button_to no, admin_inbox_decide_path(item.candidate_id, "no"), params: { ids: entry.ids }, class: "nd-btn nd-btn--outline" %>
            <% end %>
          </div>
        </li>
      <% end %>
      <%# Pending companies and plants with no open claim: decided on the record. %>
      <% records.each do |fact| %>
        <% name = fact.attributes.to_h.with_indifferent_access[:name] %>
        <% quote = fact.evidence.first %>
        <li class="nd-wait nd-inbox__item" id="inbox-record-<%= fact.type.underscore %>-<%= fact.id %>">
          <input type="checkbox" class="nd-check" name="selected[]" value="record:<%= fact.type %>:<%= fact.id %>" form="inbox-selected" data-section="<%= key %>"
            data-bulk-select-target="box" data-action="click->bulk-select#pick" aria-label="Select <%= name %>">
          <div class="nd-wait__what">
            <p class="m-0"><span class="nd-tag"><%= fact.type == "Facility" ? "Plant" : "Company" %></span></p>
            <p class="type-body m-0"><%= link_to name, admin_fact_path(type: fact.type, id: fact.id), class: "nd-link type-body-strong" %></p>
            <% if quote&.source&.url && (url = safe_url(quote.source.url)) %>
              <p class="type-small m-0"><%= link_to url, class: "nd-link whitespace-nowrap", target: "_blank", rel: "noopener" do %><%= source_host(url) %> <%= icon("arrow-square-out", size: 12) %><% end %></p>
            <% end %>
            <% if quote&.quote.present? %>
              <details class="nd-fold">
                <summary class="type-small">Why, and the source</summary>
                <div class="nd-fold__body"><blockquote class="nd-quote m-0">“<%= quote.quote %>”</blockquote></div>
              </details>
            <% end %>
          </div>
          <div class="nd-wait__actions nd-inbox__buttons type-ui">
            <%= button_to "Create", admin_inbox_decide_record_path(fact.type, fact.id, "yes"), class: "nd-btn nd-btn--primary" %>
            <%= button_to "No", admin_inbox_decide_record_path(fact.type, fact.id, "no"), class: "nd-btn nd-btn--outline" %>
          </div>
        </li>
      <% end %>
    </ol>
    <% if key == batch_after %>
      <div class="nd-panel nd-stack">
        <p class="type-body m-0">Data Quality checked <%= checked.size %> of these <%= @inbox.checkable.size %>.</p>
        <%= button_to "Yes to all #{checked.size} Data Quality checked", admin_inbox_yes_all_path, params: { shown: @inbox.yes_all_fingerprint },
          class: "nd-btn nd-btn--primary type-ui nd-inbox__all", data: { turbo_confirm: "Approve all #{checked.size}? Each is checked once more before it goes live." } %>
      </div>
    <% end %>
  </section>
<% end %>

</div>

<% recent = @inbox.recent.to_a %>
<% if recent.any? %>
  <details class="nd-fold">
    <summary class="type-body-strong">Recently decided <span class="type-count"><%= recent.size %></span></summary>
    <ul class="nd-stack m-0 p-0 list-none">
      <% recent.each do |claim| %>
        <li class="nd-inbox__recent" id="recent-<%= claim.id %>">
          <span class="type-body"><%= inbox_decision(claim) %></span>
          <span class="type-small text-ink-muted whitespace-nowrap"><%= claim.reviewed_at.today? ? "today" : (claim.reviewed_at.to_date == Date.yesterday ? "yesterday" : claim.reviewed_at.strftime("%-d %b")) %> <%= claim.reviewed_at.strftime("%H:%M") %></span>
          <% if claim.subject_id %>
            <%= link_to "Open it", admin_fact_path(type: claim.subject_type, id: claim.subject_id), class: "nd-link type-small whitespace-nowrap" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>
