<% content_for :title, "Review and accept" %>
<%
  joy = t("admin.reviewers.checker")
  aminah = t("admin.reviewers.reviewer")
  review = @review
  agree = review.rows("agree")
  shown = params[:shown].respond_to?(:permit) ? params[:shown].permit(*TodayReview::GROUPS).to_h.presence : nil
  titles = { "agree" => "#{joy} and #{aminah} agree", "only_joy" => "Only #{joy} checked", "disagree" => "#{joy} and #{aminah} disagree" }
  minutes = (review.size * Today::SECONDS_PER_FACT / 60.0).ceil
%>

<div class="nd-stack">
  <%= render "admin/crumbs", parent_label: "Today", parent_path: admin_today_path, current: "Review and accept" %>
  <h1 class="type-admin-h1 m-0">Review and accept</h1>
  <% if flash[:undo] %>
    <% content_for :flash_action do %>
      <%= button_to "Undo", admin_today_review_undo_path(shown:), params: { token: flash[:undo] }, class: "nd-link nd-flash__action type-body", form_class: "nd-flash__undo" %>
    <% end %>
  <% end %>
  <p class="type-body m-0"><%= pluralize(review.size, "fact") %> · about <%= pluralize([ minutes, 1 ].max, "minute") %>. Nothing goes live until you click.</p>

  <% if agree.any? %>
    <section class="nd-panel nd-stack" aria-label="Shortcut">
      <p class="type-body m-0"><%= joy %> and <%= aminah %> agree on the <%= pluralize(agree.size, "fact") %> shown below: both say accept. One click accepts them, each checked once more first. The others wait for your own Accept or Reject.</p>
      <%= button_to "Do the #{agree.size} they agree on", admin_today_review_agreed_path(shown:), params: { shown_set: review.fingerprint },
        class: "nd-btn nd-btn--primary type-ui",
        form: { data: { turbo_confirm: "Accept the #{pluralize(agree.size, 'fact')} #{joy} and #{aminah} both say to accept?" } } %>
    </section>
  <% end %>

  <% if review.size.zero? && @pending.zero? %>
    <p class="type-body text-ink-muted">Nothing waiting. <%= link_to "Back to Today", admin_today_path, class: "nd-link" %></p>
  <% end %>

  <% if @pending.positive? %>
    <section class="nd-panel nd-stack" aria-label="Waiting without a check">
      <p class="type-body m-0"><%= pluralize(@pending, "fact") %> <%= @pending == 1 ? "waits" : "wait" %> without a check from <%= joy %>, such as ones added by hand. Decide them on their own list.</p>
      <%= link_to "Decide #{@pending == 1 ? 'it' : 'them'} ›", admin_pending_facts_path, class: "nd-btn nd-btn--outline type-ui" %>
    </section>
  <% end %>

  <% TodayReview::GROUPS.each do |group| %>
    <% rows = review.rows(group) %>
    <% next if rows.empty? %>
    <section class="nd-stack" aria-labelledby="run-<%= group %>">
      <h2 class="type-admin-h2 m-0" id="run-<%= group %>"><%= titles.fetch(group) %> <span class="type-data nd-num text-ink-muted"><%= review.count(group) %></span></h2>
      <ol class="nd-waits">
        <% rows.each do |row| %>
          <% item = row.item %>
          <li class="nd-wait nd-verdict" id="fact-<%= row.candidate_id %>">
            <div class="nd-wait__what">
              <p class="type-small text-ink-muted m-0"><%= claim_number(*row.candidate_ids) %></p>
              <p class="type-body-strong m-0"><%= claim_text(item) %></p>
              <p class="nd-verdict__chips type-ui m-0">
                <span class="nd-tag<%= ' nd-verdict__chip--muted' unless row.joy == 'accept' %>"><%= row.joy == "accept" ? "✓ #{joy}: accept" : "#{joy}: check it" %></span>
                <span class="nd-tag<%= ' nd-verdict__chip--muted' if row.aminah.nil? %>"><%= { "accept" => "✓ #{aminah}: accept", "reject" => "✕ #{aminah}: reject" }.fetch(row.aminah, "#{aminah}: not reviewed") %></span>
              </p>
              <% if item.differences.any? %>
                <p class="type-small m-0">Accepting replaces the checked <%= item.differences.map { |name, (stored, incoming)| "#{field_label(name).downcase_first} (#{stored} → #{incoming})" }.to_sentence %>.</p>
              <% end %>
              <% if row.others.any? %>
                <p class="type-small m-0">Also on <%= pluralize(row.others.size, "other page") %>:
                  <%= safe_join(row.others.map { |other| (url = safe_url(other.source.url)) ? link_to("#{source_host(url)} ↗", url, class: "nd-link", target: "_blank", rel: "noopener") : other.source.url }, ", ") %>.
                  One decision covers <%= row.others.one? ? "both" : "all #{row.others.size + 1}" %>.</p>
              <% end %>
              <details class="type-small">
                <summary class="nd-link">Why, and the source</summary>
                <p class="m-0"><%= joy %>: <%= item.ai_reason.presence || "no reason given" %></p>
                <p class="m-0"><%= aminah %>: <%= review.aminah_reason(item).presence || "#{aminah} didn't review this one." %></p>
                <% if (url = safe_url(item.source.url)) %>
                  <p class="m-0"><%= link_to "#{source_host(url)} ↗", url, class: "nd-link", target: "_blank", rel: "noopener" %></p>
                <% end %>
              </details>
            </div>
            <% if row.candidate_ids.all? { |id| @restating.include?(id) } %>
              <p class="type-small m-0">It says what the site already shows. Closing notes that in the history and changes nothing live.</p>
              <div class="nd-wait__actions nd-verdict__actions">
                <%= button_to "Close: already on the site", admin_today_review_decide_path(candidate_id: row.candidate_id, decision: "close", shown:), params: { same: row.candidate_ids },
                  class: "nd-btn nd-btn--primary type-ui" %>
              </div>
            <% else %>
            <div class="nd-wait__actions nd-verdict__actions">
              <%= button_to "Accept", admin_today_review_decide_path(candidate_id: row.candidate_id, decision: "accept", shown:), params: { same: row.candidate_ids },
                class: "nd-btn #{row.agree? ? 'nd-btn--primary' : 'nd-btn--outline'} type-ui" %>
              <%= button_to row.item.differences.any? ? "Keep" : "Reject", admin_today_review_decide_path(candidate_id: row.candidate_id, decision: "reject", shown:), params: { same: row.candidate_ids },
                class: "nd-btn nd-btn--outline type-ui" %>
            </div>
            <% end %>
          </li>
        <% end %>
      </ol>
      <% if (more = review.more(group)).positive? %>
        <p class="m-0"><%= link_to "Show #{[ more, TodayReview::PAGE ].min} more", admin_today_review_path(shown: (shown || {}).merge(group => review.pages(group) + 1), anchor: "run-#{group}"),
          class: "nd-btn nd-btn--outline type-ui" %> <span class="type-small text-ink-muted"><%= more %> not shown</span></p>
      <% end %>
    </section>
  <% end %>
</div>
