<% content_for :title, "Leads" %>
<% keep = { tab: (@tab unless @tab == "new"), sort: (@sort unless @sort == "date"), dir: (@dir unless @dir == "desc") }.compact %>
<% sort_link = lambda do |key, label|
     current = @sort == key
     dir = current && @dir == "desc" ? "asc" : "desc"
     link_to admin_leads_path(**keep, sort: key, dir:), class: "nd-link whitespace-nowrap" do
       safe_join([ label, (icon(@dir == "desc" ? "caret-down" : "caret-up", size: 12) if current) ].compact, " ")
     end
   end %>

<div>
  <h1 class="type-admin-h1">Leads <span class="type-count"><%= @counts["new"] %></span></h1>
  <p class="type-body text-ink-muted">Research: add it to the research list. Covered: we already have it, under another name. Ignore: not a lead.</p>
</div>

<div class="nd-row">
  <%= button_to "Bring up to date", refresh_admin_leads_path(**keep), class: "nd-btn nd-btn--outline type-ui" %>
</div>

<nav class="nd-fchips type-ui" aria-label="Status">
  <% Admin::LeadsController::TABS.each do |tab, (label, _)| %>
    <%= link_to admin_leads_path(**keep.except(:tab), tab: (tab unless tab == "new")), class: "nd-fchip", aria: { current: ("page" if tab == @tab) } do %>
      <%= label %> <span class="type-data nd-num"><%= @counts[tab] %></span>
    <% end %>
  <% end %>
</nav>

<% if @leads.empty? %>
  <p class="type-body text-ink-muted">Nothing here.</p>
<% else %>
  <table class="nd-numtable nd-stack-table nd-leads">
    <thead>
      <tr>
        <th scope="col" class="nd-l" aria-sort="<%= @sort == "date" ? (@dir == "desc" ? "descending" : "ascending") : "none" %>"><%= sort_link.("date", "Date") %></th>
        <th scope="col" class="nd-l">Lead</th>
        <th scope="col" class="nd-l">Source</th>
        <th scope="col" aria-sort="<%= @sort == "seen" ? (@dir == "desc" ? "descending" : "ascending") : "none" %>"><%= sort_link.("seen", "Seen") %></th>
        <th scope="col" class="nd-l">Status</th>
        <th scope="col" class="nd-l">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @leads.each do |lead| %>
        <% source = lead.sources.max_by { |each| each["last"].to_s } %>
        <tr id="lead-<%= lead.id %>">
          <td class="nd-l type-data whitespace-nowrap">
            <span class="block">First <%= lead.first_seen_on.strftime("%-d %b") %></span>
            <span class="block">Last <%= lead.last_seen_on.strftime("%-d %b") %></span>
          </td>
          <td class="nd-leads__lead nd-l">
            <p class="type-body-strong m-0 truncate max-w-[28ch]" title="<%= lead.name %>" data-truncate><%= lead.name %></p>
            <p class="type-small text-ink-muted m-0"><%= lead.kind.humanize %></p>
            <% if (record = lead.record) %>
              <p class="type-small m-0"><%= link_to record.name, admin_record_path(type: lead.record_type, id: record.id), class: "nd-link" %></p>
            <% end %>
            <% if lead.status_ignored? && lead.reason.present? %><p class="type-small text-ink-muted m-0"><%= lead.reason %></p><% end %>
            <% if lead.note.present? %><p class="type-small text-ink-muted m-0"><%= lead.note %></p><% end %>
          </td>
          <td class="nd-l type-small whitespace-nowrap">
            <% if (url = safe_url(source&.dig("url"))) %>
              <%= link_to url, class: "nd-link", target: "_blank", rel: "noopener", title: source["label"] do %><%= source_host(url) %> <%= icon("arrow-square-out", size: 12) %><% end %>
            <% else %>
              <span title="<%= source&.dig("label") %>"><%= source&.dig("key").to_s.start_with?("search:") ? "A search on the site" : source&.dig("label").to_s.truncate(28) %></span>
            <% end %>
            <% if lead.sources.size > 1 %><span class="text-ink-muted"> +<%= lead.sources.size - 1 %></span><% end %>
          </td>
          <td class="type-cell-num" data-unit="seen"><%= lead.seen_count %></td>
          <td class="nd-l"><span class="nd-tag"><%= Admin::LeadsController::STATUS_LABELS.fetch(lead.status) %></span></td>
          <td class="nd-l nd-leads__actions">
            <div class="nd-leads__buttons type-ui">
              <% if lead.status_new? || lead.status_researching? %>
                <% if lead.status_new? %>
                  <%= button_to "Research", research_admin_lead_path(lead, **keep), class: "nd-btn nd-btn--outline type-ui",
                    title: lead.kind == "company" ? "Read its pages if we have it, or add it to the research list" : "Add it to the research list" %>
                <% end %>
                <%# Its form opens as a panel under the button (a sheet on phones), over the page, so the row keeps its shape (Design on #546). %>
                <details class="nd-rowmenu" data-controller="row-menu" data-action="toggle->row-menu#toggle keydown.esc->row-menu#close">
                  <summary class="nd-btn nd-btn--outline type-ui"><span class="nd-leads__long">Already covered</span><span class="nd-leads__short">Covered</span></summary>
                  <div class="nd-rowmenu__panel">
                    <%= form_with url: covered_admin_lead_path(lead, **keep), method: :post, class: "nd-rowmenu__takeoff" do %>
                      <label for="record-<%= lead.id %>" class="type-body-strong">The company or plant that has it</label>
                      <%= text_field_tag :record, nil, id: "record-#{lead.id}", class: "nd-input type-input", placeholder: "Its name in the directory", required: true %>
                      <button type="submit" class="nd-btn nd-btn--primary type-ui">Link it</button>
                      <button type="button" class="nd-btn nd-btn--outline type-ui nd-leads__cancel" data-action="row-menu#close">Cancel</button>
                    <% end %>
                  </div>
                </details>
                <details class="nd-rowmenu" data-controller="row-menu" data-action="toggle->row-menu#toggle keydown.esc->row-menu#close">
                  <summary class="nd-btn nd-btn--outline type-ui">Ignore</summary>
                  <div class="nd-rowmenu__panel">
                    <%= form_with url: ignore_admin_lead_path(lead, **keep), method: :post, class: "nd-rowmenu__takeoff" do %>
                      <label for="reason-<%= lead.id %>" class="type-body-strong">Why it's ignored</label>
                      <%= text_field_tag :reason, nil, id: "reason-#{lead.id}", class: "nd-input type-input", required: true, placeholder: "Not nuclear, a typo…" %>
                      <button type="submit" class="nd-btn nd-btn--primary type-ui">Ignore it</button>
                      <button type="button" class="nd-btn nd-btn--outline type-ui nd-leads__cancel" data-action="row-menu#close">Cancel</button>
                    <% end %>
                  </div>
                </details>
              <% else %>
                <%= button_to "Put back", reopen_admin_lead_path(lead, **keep), class: "nd-btn nd-btn--outline type-ui" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @more %>
    <div><%= link_to "Next #{Admin::LeadsController::PAGE}", admin_leads_path(**keep, page: @page + 1), class: "nd-btn nd-btn--outline type-ui" %></div>
  <% end %>
<% end %>

<details class="nd-panel">
  <summary class="type-body-strong">Add leads</summary>
  <%= form_with url: admin_leads_path, method: :post, class: "nd-stack" do %>
    <div class="nd-field">
      <label for="names" class="type-small">One name per line, with a note after a colon, or Data Quality's Leads.md table as it is.</label>
      <%= text_area_tag :names, nil, rows: 6, class: "nd-input type-input", placeholder: "Example Fusion: named in a DOE GAIN list" %>
    </div>
    <div class="nd-field">
      <label for="kind" class="type-small">They're all</label>
      <%= select_tag :kind, options_for_select([ [ "Companies", "company" ], [ "Plants", "plant" ], [ "Other", "other" ] ], "company"), class: "nd-select type-ui" %>
    </div>
    <div><button type="submit" class="nd-btn nd-btn--primary type-ui">Add leads</button></div>
  <% end %>
</details>
