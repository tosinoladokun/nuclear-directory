<% content_for :title, "Edit, then approve" %>
<% source_url = safe_url(@item.source.url) %>

<div class="nd-stack max-w-prose">
  <div class="nd-shell__head">
    <%= render "admin/crumbs", parent_label: from_fact ? "Back" : "Checks", parent_path: from_fact || back_path(admin_checks_path(filters.slice("category", "source"))), current: "Edit, then approve" %>
    <%= render "admin/itemnav", list: @list if @list %>
  </div>
  <h1 class="type-admin-h1 m-0">Edit, then approve</h1>
  <p class="nd-item__claim type-body-strong"><%= @item.claim %></p>
  <% if @item.quote.present? %><blockquote class="nd-quote">“<%= @item.quote %>”</blockquote><% end %>
  <% if source_url %>
    <p class="type-small m-0"><%= link_to source_url, class: "nd-link nd-link--muted nd-tap", target: "_blank", rel: "noopener" do %><%= @item.source.title.presence || source_host(source_url) %> <%= icon("arrow-square-out", size: 12) %><% end %></p>
  <% end %>
  <% if @item.differences.any? %>
    <p class="m-0"><strong>Differs from the human-verified record:</strong>
      <%= @item.differences.map { |name, (stored, incoming)| "#{field_label(name).downcase_first} is #{stored} there, #{incoming} here" }.to_sentence %>.</p>
  <% end %>

  <%= form_with url: admin_candidate_path(@item.candidate_id, **item_context), method: :patch, class: "nd-stack" do |form| %>
    <%# Enter in a field does nothing: approving takes a click (as in the queue). %>
    <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
    <% if @errors.present? %>
      <div class="nd-alert" role="alert">
        <p class="type-body-strong">Not approved. Fix this and approve again:</p>
        <ul class="type-body"><% @errors.each do |error| %><li><%= error.upcase_first %></li><% end %></ul>
      </div>
    <% end %>
    <% @fields.each do |name| %>
      <%# After a failed approval, show what was typed so it can be corrected. %>
      <% value = params.dig(:values, name) || @item.payload[name] %>
      <div class="nd-field">
        <%= label_tag "values_#{name}", field_label(name), class: "type-body-strong" %>
        <% if value.is_a?(Array) || value.is_a?(Hash) %>
          <span><%= field_value(value) %></span>
          <span class="type-small text-ink-muted">Can't be edited here.</span>
        <% else %>
          <%= text_field_tag "values[#{name}]", value, id: "values_#{name}", class: "nd-input type-input" %>
        <% end %>
      </div>
    <% end %>
    <div class="nd-field">
      <label for="note" class="type-body-strong">What you changed and why <span class="type-small text-ink-muted">(optional, kept in the record's history)</span></label>
      <%= text_field_tag :note, params[:note], class: "nd-input type-input" %>
    </div>
    <div class="nd-row">
      <%= form.submit "Approve with these values", class: "nd-btn nd-btn--primary" %>
      <%= link_to "Cancel", back_path(admin_checks_path(filters.slice("category", "source"))), class: "nd-btn nd-btn--outline" %>
    </div>
  <% end %>

  <%# Or reject it here (#269), then on to the next claim, as from the fact page. %>
  <details class="nd-decide__reject nd-fold" data-controller="decide" data-decide-target="panel">
    <summary class="type-body">Reject</summary>
    <%= form_with url: reject_admin_candidates_path, class: "nd-fold__body nd-wait__more" do %>
      <button type="submit" disabled hidden aria-hidden="true" tabindex="-1"></button>
      <%= hidden_field_tag :back, back_path(admin_checks_path(filters.slice("category", "source"))), id: nil %>
      <%= hidden_field_tag :next, done_path || from_fact || @list&.dig(:next), id: nil if done_path || from_fact || @list&.dig(:next) %>
      <div class="nd-field">
        <label for="edit-reject-reason" class="type-body-strong">Reason (optional)</label>
        <input type="text" class="nd-input type-input" id="edit-reject-reason" name="reasons[<%= @item.candidate_id %>]">
        <span class="type-small text-ink-muted">Kept in the history</span>
      </div>
      <div class="nd-wait__actions type-ui">
        <button type="submit" class="nd-btn nd-btn--primary" name="candidate_id" value="<%= @item.candidate_id %>">Reject</button>
        <button type="button" class="nd-btn nd-btn--outline" data-action="decide#close">Cancel</button>
      </div>
    <% end %>
  </details>
</div>
