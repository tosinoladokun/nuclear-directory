<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Nuclear Directory" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nuclear Directory">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# No hover prefetch: each page opened from a link or address reaches the
        server once and counts as one view (Back and Forward restore Turbo's copy
        and aren't counted), and the 512 MB instance skips speculative requests (#68). %>
    <meta name="turbo-prefetch" content="false">
    <% if analytics_snippet? %>
      <%# Anonymous page views and page leaves (PostHog, cookieless). Public project key, safe in page source. %>
      <meta name="posthog-key" content="<%= Analytics.public_key %>">
      <%# Through our own /relay (#205), which adds the visitor's country. %>
      <meta name="posthog-host" content="/relay">
    <% end %>

    <%= yield :head %>
    <%= render "shared/link_preview" %>

    <%# Site icon: a nucleus with two orbits (script/build_site_icon.py). %>
    <link rel="icon" href="<%= site_icon_path("favicon.ico") %>" sizes="48x48">
    <link rel="icon" href="<%= site_icon_path("icon.svg") %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= site_icon_path("apple-touch-icon.png") %>">
    <link rel="manifest" href="<%= site_icon_path("manifest.webmanifest") %>">
    <% ApplicationHelper::THEME_COLORS.each do |scheme, color| %>
      <meta name="theme-color" media="(prefers-color-scheme: <%= scheme %>)" content="<%= color %>">
    <% end %>

    <%# Fonts: Anton + Roboto Serif (from techequity.us) and Roboto Mono. See DESIGN.md. %>
    <%= render "shared/fonts" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# Each page renders its own <main> after the site header, so the header
        stays outside the main landmark and there's only ever one. %>
    <%= yield %>
    <%= render "shared/site_footer", compact: content_for?(:compact_footer) %>
  </body>
</html>
