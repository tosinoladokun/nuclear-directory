<% content_for :title, "Forgot password" %>
<div class="nd-signin">
  <h1 class="type-title-md m-0">Forgot password</h1>
  <p class="type-body m-0">We'll email you a link to set a new one.</p>
  <%= form_with url: passwords_path, class: "nd-stack" do |form| %>
    <div class="nd-field">
      <%= form.label :email_address, "Email address", class: "type-body-strong" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "nd-input type-input" %>
    </div>
    <div><%= form.submit "Email me a link", class: "nd-btn nd-btn--primary" %></div>
  <% end %>
  <p class="type-small m-0"><%= link_to "Back to sign in", new_session_path, class: "nd-link" %></p>
</div>
