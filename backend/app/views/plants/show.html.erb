<%
  p = @profile
  owners, operators, vendors, buyers = PlantProfile::LINK_ORDER.map { |type| p.companies_for(type) }
  where = place(p.city, p.state)
  tags = [ facility_type_label(p.facility_type), facility_status_label(p.status), *p.technologies ].compact
  company_links = ->(orgs) { safe_join(orgs.map { |o| link_to(o.name, company_url_for(o), class: "nd-link") }, ", ") if orgs.any? }
  capacity = "#{number_with_precision(p.capacity_mw, precision: 2, strip_insignificant_zeros: true, delimiter: ",")} MW" if p.capacity_mw
  content_for :title, "#{plant_title(p)} · Nuclear Directory"
  content_for :og_title, p.name
  @link_card = [ LinkCard.for_plant(p), "plants", p.slug ] # its preview image (#245)
  # One line for link previews and search results (#246).
  preview = plant_preview(p)
  content_for :og_description, preview
%>
<% content_for :head do %>
  <meta name="description" content="<%= preview %>">
  <link rel="canonical" href="<%= plant_url(slug: p.slug) %>">
<% end %>
<%= render "shared/site_header" %>

<main class="nd-page nd-page--company">
  <%# In the body, not the head: Turbo keeps head scripts from earlier pages, which would pile up one graph per profile visited. %>
  <%= json_ld_tag(plant_json_ld(p, page_url: plant_url(slug: p.slug))) %>
  <nav class="nd-crumbs" aria-label="Breadcrumb">
    <%= link_to "Plants and sites", directory_url_for(category: Category.find("plants")), class: "nd-link nd-link--muted" %> / <span aria-current="page"><%= p.name %></span>
  </nav>

  <%
    owner_parties = p.parties_for("owns")
    operator_parties = p.parties_for("operates")
    vendor_parties = p.parties_for("vendor_for")
    buyer_parties = p.parties_for("offtakes_from")
    parties_count = (owner_parties + operator_parties + vendor_parties).size
    # The section is named after the groups it has (an "operator" only when there is one); the index uses the short word.
    group_names = [ ("owners" if owner_parties.any?), ("operator" if operator_parties.any?), ("developer" if vendor_parties.any?) ].compact
    parties_title = if group_names == [ "developer" ] then "Reactor developer"
                    else group_names.to_sentence(two_words_connector: " and ", last_word_connector: " and ", words_connector: ", ").upcase_first
                    end
    parties_index = owner_parties.any? ? "Owners" : parties_title
    share_decimals = (owner_parties + operator_parties + vendor_parties).any? { |party| party.share && (party.share % 1).nonzero? }
    operating = p.operating_units.size
    units_text = if p.units.empty? then nil
                 elsif p.status.present? && operating.positive? && operating < p.units.size then "#{operating} of #{p.units.size} units"
                 else pluralize(p.units.size, "unit")
                 end
    tags = [ facility_type_label(p.facility_type), *p.reactor_types ].compact
    cite_text = "Nuclear Directory. “#{p.name}.” #{plant_url(slug: p.slug)}. Accessed #{Date.current.strftime("%-d %B %Y")}."
    covers = ->(parties) { parties.filter_map { |party| p.units_phrase(party) }.presence&.join("; ") }
    index = [ { label: "Overview", href: "#overview", current: true } ]
    index << { label: parties_index, href: "#parties", count: parties_count } if parties_count.positive?
    index << { label: "Deals and links", href: "#deals", count: buyer_parties.size } if buyer_parties.any?
    index << { label: "Units", href: "#units", count: p.units.size } if p.units.any?
    index << { label: "Sources", href: "#sources", count: p.citations.sources.size } if p.citations.sources.any?
    facts = [
      { label: "Status", note: units_text, value: (render("shared/status_mark", status: p.status) if p.status.present?) },
      { label: "Capacity", note: (p.capacity_leaves_out_units? ? "operating units, net summer (EIA)" : "net summer (EIA)"), value: capacity },
      { label: "Location", value: location(p.city, p.state) },
      { label: operators = (p.companies_for("operates").size > 1 ? "Operators" : "Operator"), value: company_links.(p.companies_for("operates")), wide: p.companies_for("operates").size > 1 },
      { label: p.companies_for("vendor_for").size > 1 ? "Reactor developers" : "Reactor developer", value: company_links.(p.companies_for("vendor_for")),
        note: covers.(vendor_parties), wide: p.companies_for("vendor_for").size > 1 },
      { label: p.reactor_types.size > 1 ? "Reactor types" : "Reactor type", value: p.reactor_types.join(", ").presence, wide: p.reactor_types.size > 1 },
      { label: "Type", value: facility_type_label(p.facility_type) },
      { label: "NRC docket", value: (p.nrc_docket if p.units.size <= 1) }
    ]
  %>
  <div class="nd-company" data-controller="section-index">
    <div class="nd-company__index"><%= render "shared/index", items: index, label: "On this page" %></div>

    <div class="nd-company__head" id="overview">
      <%= render "shared/page_head", name: p.name, tags: %>
      <% if p.status.present? %><p class="nd-plantstatus"><%= render "shared/status_mark", status: p.status %><% if units_text %><span class="text-ink-muted"> · <%= units_text %></span><% end %></p><% end %>
      <% sentence = plant_owner_sentence(p) %>
      <% if sentence %>
        <p class="nd-pagehead__about nd-sentence nd-sentence--wide"><%= sentence %></p>
        <p class="nd-pagehead__about nd-sentence nd-sentence--narrow"><%= plant_owner_sentence(p, narrow: true) %></p>
      <% end %>
    </div>

    <div class="nd-company__glance"><%= render "shared/glance", facts: %></div>

    <div class="nd-company__main nd-secs">
      <% if parties_count.positive? %>
        <section aria-labelledby="parties-heading" id="parties">
          <%= render "shared/section_head", title: parties_title, count: parties_count, id: "parties-heading" %>
          <% [ [ "Owners", owner_parties ], [ "Operator", operator_parties ], [ "Reactor developer", vendor_parties ] ].each do |label, parties| %>
            <% next if parties.empty? %>
            <div class="nd-partygroup">
              <p class="nd-label"><%= label %><% if parties.size > 1 %> · <%= parties.size %><% end %></p>
              <ul class="nd-crows"><%= safe_join(parties.map { |party| render("plants/party_row", party:, profile: p, verb: false, decimals: share_decimals) }) %></ul>
            </div>
          <% end %>
        </section>
      <% end %>

      <% if buyer_parties.any? %>
        <section aria-labelledby="deals-heading" id="deals">
          <%= render "shared/section_head", title: "Deals and links", count: buyer_parties.size, id: "deals-heading" %>
          <ul class="nd-crows"><%= safe_join(buyer_parties.map { |party| render("plants/party_row", party:, profile: p) }) %></ul>
        </section>
      <% end %>

      <% if p.units.any? %>
        <section aria-labelledby="units-heading" id="units">
          <%= render "shared/section_head", title: "Units", count: p.units.size, id: "units-heading" %>
          <%= render "plants/units_table", units: p.units, profile: p %>
        </section>
      <% end %>
    </div>

    <%= render "shared/page_end", sources: p.citations.sources, cite_text:, subject: p.name %>
  </div>
</main>
