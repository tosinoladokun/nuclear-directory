<%
  p = @profile
  owners, operators, vendors, buyers = PlantProfile::LINK_ORDER.map { |type| p.companies_for(type) }
  where = place(p.city, p.state)
  tags = [ facility_type_label(p.facility_type), facility_status_label(p.status), *p.technologies ].compact
  company_links = ->(orgs) { safe_join(orgs.map { |o| link_to(o.name, company_url_for(o), class: "nd-link") }, ", ") if orgs.any? }
  cited = ->(type) { p.links.select { |l| l.relationship_type == type }.flat_map { |l| p.citations_for(l) }.uniq(&:first) }
  # Technology, reactor type and capacity come from the site and its units.
  details_cited = (p.site_citations + p.units.flat_map { |u| p.citations_for(u) }).uniq(&:first)
  capacity = "#{number_with_precision(p.capacity_mw, precision: 2, strip_insignificant_zeros: true, delimiter: ",")} MW" if p.capacity_mw
  content_for :title, "#{plant_title(p)} · Nuclear Directory"
  content_for :og_title, p.name
  @link_card = [ LinkCard.for_plant(p), "plants", p.slug ] # its preview image (#245)
  # One line for link previews and search results (#246).
  preview = plant_preview(p)
  content_for :og_description, preview
%>
<% content_for :head do %>
  <meta name="description" content="<%= preview %>">
  <link rel="canonical" href="<%= plant_url(slug: p.slug) %>">
<% end %>
<%= render "shared/site_header" %>

<main class="nd-page">
  <nav class="nd-crumbs" aria-label="Breadcrumb">
    <%= link_to "Plants and sites", directory_url_for(category: Category.find("plants")), class: "nd-link nd-link--muted" %> / <span aria-current="page"><%= p.name %></span>
  </nav>

  <%= render "shared/profile_header", name: p.name, kind: :plant, tags:,
        site_icon: site_icon_name(p.facility_type, reactor_types: p.reactor_types, status: p.status) %>

  <%# Key facts come first in reading and focus order; wide screens place them on the right. %>
  <div class="nd-columns nd-columns--profile">
    <div class="nd-columns__side">
      <%= render "shared/overview_panel", verified_at: p.verified_at, verified: p.site.verified?, correction_url: correction_url_for(p.name), rows: [
            [ "Type", facility_type_label(p.facility_type), p.site_citations ],
            [ "Status", facility_status_label(p.status), p.site_citations ],
            [ "Location", where, p.site_citations ],
            [ owners.size > 1 ? "Owners" : "Owner", company_links.(owners), cited.("owns") ],
            [ operators.size > 1 ? "Operators" : "Operator", company_links.(operators), cited.("operates") ],
            [ vendors.size > 1 ? "Reactor developers" : "Reactor developer", company_links.(vendors), cited.("vendor_for") ],
            [ buyers.size > 1 ? "Power buyers" : "Power buyer", company_links.(buyers), cited.("offtakes_from") ],
            [ "Technology", p.technologies.join(", ").presence, details_cited ],
            [ p.reactor_types.size > 1 ? "Reactor types" : "Reactor type", p.reactor_types.join(", ").presence, details_cited ],
            [ "Capacity", capacity, details_cited,
              p.capacity_leaves_out_units? ? "Net summer capacity of operating units, from EIA" : "Net summer capacity, from EIA" ],
            [ "NRC docket", p.nrc_docket, p.site_citations ]
          ] %>
    </div>

    <%# Connections (#363): under the header across both columns on wide screens, after the key facts on phones. %>
    <% map = ConnectionsMap.for_plant(p) %>
    <%= render("shared/connections_map", map:) if map.edges.any? %>

    <div class="nd-columns__main">
      <% if p.links.any? %>
        <section aria-labelledby="companies-heading">
          <h2 id="companies-heading" class="nd-sec-h">Companies <small><%= p.links.size %></small></h2>
          <%= render "companies/collapsible_list", label: "companies",
                rows: p.links.map { |link| render("plants/company_link_row", link:, profile: p) } %>
        </section>
      <% end %>

      <% if p.units.any? %>
        <section aria-labelledby="units-heading">
          <h2 id="units-heading" class="nd-sec-h">Units <small><%= p.units.size %></small></h2>
          <%= render "plants/units_table", units: p.units, profile: p %>
        </section>
      <% end %>

      <%= render "shared/missing_fields", fields: p.missing_fields, suggest_url: correction_url_for("#{p.name}: #{p.missing_fields.join(", ")}") %>

      <% if p.citations.sources.any? %>
        <section aria-labelledby="sources-heading">
          <h2 id="sources-heading" class="nd-sec-h">Sources <small><%= p.citations.sources.size %></small></h2>
          <%= render "shared/sources_list", sources: p.citations.sources %>
        </section>
      <% end %>
    </div>
  </div>
</main>
