<%# The site's verified units. A table on wide screens; on phones each row
    becomes a card with the column name before each value (#90). A column
    no unit has a value for is left out, Sources included. Locals: units, profile. %>
<% columns = {
     "Reactor type" => ->(u) { u.reactor_type.presence },
     "Capacity" => ->(u) { "#{number_with_precision(u.capacity_mw, precision: 2, strip_insignificant_zeros: true, delimiter: ",")} MW" if u.capacity_mw },
     "Status" => ->(u) { facility_status_label(u.status) },
     "NRC docket" => ->(u) { u.nrc_docket }
   }.select { |_, value| units.any? { |unit| value.(unit) } } %>
<% sourced = units.any? { |unit| profile.citations_for(unit).any? } %>
<div class="nd-table-wrap nd-table-wrap--cards">
  <table class="nd-table nd-table--cards">
    <thead>
      <tr><th scope="col">Unit</th><% columns.each_key do |heading| %><th scope="col"><%= heading %></th><% end %><% if sourced %><th scope="col">Sources</th><% end %></tr>
    </thead>
    <tbody>
      <% units.each do |unit| %>
        <tr id="unit-<%= unit.slug %>">
          <%# An older anchor for this row (#333), so links made before the unit moved still land here. %>
          <th scope="row"><% unit.unit_anchors(units.map(&:slug) - [ unit.slug ]).drop(1).each do |anchor| %><span id="<%= anchor %>"></span><% end %><%= unit.name %></th>
          <% columns.each do |heading, value| %>
            <td data-label="<%= heading %>"<% if heading.in?([ "Capacity", "NRC docket" ]) %> class="type-data"<% end %>><%= value.(unit) %></td>
          <% end %>
          <% if sourced %><td data-label="Sources"><% profile.citations_for(unit).each do |number, source| %><%= render "shared/source_chip", number:, source:, compact: true %><% end %></td><% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
