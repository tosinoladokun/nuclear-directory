<%# The site's verified units (#557): a table on desktop with Unit, Reactor, Capacity, Status (mark and word),
    NRC docket and Sources (the mark); on phones two-line rows (unit and status; then reactor, capacity, docket). A
    column no unit has a value for is left out. Each unit keeps its #unit-<slug> link. Locals: units, profile. %>
<% columns = {
     "Reactor" => ->(u) { u.reactor_type.presence },
     "Capacity" => ->(u) { "#{number_with_precision(u.capacity_mw, precision: 2, strip_insignificant_zeros: true, delimiter: ",")} MW" if u.capacity_mw },
     "NRC docket" => ->(u) { u.nrc_docket }
   }.select { |_, value| units.any? { |unit| value.(unit) } } %>
<% statused = units.any? { |unit| unit.status.present? } %>
<% sourced = units.any? { |unit| profile.citations_for(unit).any? } %>
<div class="nd-utable-wrap">
  <table class="nd-utable">
    <thead>
      <tr><th scope="col">Unit</th><% columns.each_key do |heading| %><th scope="col"><%= heading %></th><% end %><% if statused %><th scope="col">Status</th><% end %><% if sourced %><th scope="col"><span class="sr-only">Sources</span></th><% end %></tr>
    </thead>
    <tbody>
      <% units.each do |unit| %>
        <tr id="unit-<%= unit.slug %>">
          <%# An older anchor for this row (#333), so links made before the unit moved still land here. %>
          <th scope="row" class="nd-utable__unit"><% unit.unit_anchors(units.map(&:slug) - [ unit.slug ]).drop(1).each do |anchor| %><span id="<%= anchor %>"></span><% end %><%= unit.name %></th>
          <% columns.each do |heading, value| %>
            <td data-col="<%= heading.parameterize %>"<% if heading.in?([ "Capacity", "NRC docket" ]) %> class="type-data"<% end %>><%= value.(unit) %></td>
          <% end %>
          <% if statused %><td data-col="status" class="nd-utable__status"><%= render("shared/status_mark", status: unit.status) if unit.status.present? %></td><% end %>
          <% if sourced %><td data-col="sources" class="nd-utable__src"><%= render "shared/source_mark", citations: profile.citations_for(unit), checked: unit.verified_at %></td><% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
