<%# A code block in a white panel with a Copy button (#660). Locals: text. %>
<div class="nd-codebox" data-controller="copy">
  <pre class="nd-codebox__text type-data" data-copy-target="text"><%= text %></pre>
  <button type="button" class="nd-btn nd-btn--sm" data-action="copy#copy"><span data-copy-target="label">Copy</span></button>
</div>
