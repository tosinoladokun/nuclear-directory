<% content_for :title, "NuclearDirectoryBot · Nuclear Directory" %>
<% content_for :head do %>
  <link rel="canonical" href="<%= bot_url %>">
  <meta name="description" content="NuclearDirectoryBot keeps Nuclear Directory up to date from public pages. It follows robots.txt, visits each page at most once a day and stops when blocked.">
<% end %>
<%= render layout: "pages/frame", locals: { current: :bot, title: "NuclearDirectoryBot", updated: "October 2026",
      summary: "NuclearDirectoryBot is the crawler that keeps Nuclear Directory up to date. It reads public pages, such as regulator filings, company press releases and news reports, for facts about the US nuclear industry. It follows robots.txt, and you can block it.",
      facts: [ { label: "Pace", value: "Every #{DataQuality::Fetcher::HOST_INTERVAL} seconds", note: "per site" },
               { label: "Visits", value: "Once a day", note: "at most, per page" },
               { label: "Rules", value: "Follows robots.txt" }, { label: "Blocked", value: "It stops" } ] } do %>
  <section class="nd-info__sec" aria-labelledby="identity">
    <h2 id="identity" class="nd-info__h">How to recognize it</h2>
    <p>Every request sends this user agent:</p>
    <%= render "pages/code", text: DataQuality::Fetcher::USER_AGENT %>
  </section>

  <section class="nd-info__sec" aria-labelledby="behaviour">
    <h2 id="behaviour" class="nd-info__h">How it behaves</h2>
    <p>It checks every page against the site's robots.txt, including pages it's redirected to, and reads a site's robots.txt once per visit, not once per page. It waits <%= DataQuality::Fetcher::HOST_INTERVAL %> seconds between requests to the same site.</p>
    <p>It fetches each page at most once a day and asks only for changes (ETag and Last-Modified), so an unchanged page costs a short reply. When a site blocks it, it stops. It doesn't retry, work around the block or pretend to be a browser.</p>
  </section>

  <section class="nd-info__sec" aria-labelledby="blocking">
    <h2 id="blocking" class="nd-info__h">How to block it</h2>
    <p>Open your site's robots.txt and add these two lines. It stops on its next visit.</p>
    <%= render "pages/code", text: "User-agent: #{DataQuality::Fetcher::AGENT_TOKEN}\nDisallow: /" %>
  </section>

  <section class="nd-info__sec" aria-labelledby="contact">
    <h2 id="contact" class="nd-info__h">Questions about a visit</h2>
    <p>Email <%= mail_to DataQuality::Fetcher::CONTACT_EMAIL, nil, class: "nd-link" %> with the time and the page, or the reference number from your firewall's block page.</p>
  </section>
<% end %>
