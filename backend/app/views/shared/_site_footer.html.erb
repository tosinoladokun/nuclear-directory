<%# The footer on every public page (#56, #660). Desktop: three columns (the wordmark and a line; Directory; About) and one
    mono line of live counts. Phones: one wrapped row of small muted links, each a 44px tap row. %>
<footer class="nd-footer">
  <div class="nd-footer__desk">
    <div class="nd-footer__brand">
      <a class="nd-footer__mark" href="/"><span class="sr-only">Nuclear Directory</span><%= render "shared/wordmark" %></a>
      <p class="type-small text-ink-muted">The US nuclear industry, from public sources.</p>
    </div>
    <nav class="nd-footer__col" aria-label="Directory">
      <h2 class="nd-footer__label">Directory</h2>
      <%= link_to "All companies", companies_path %>
      <%= link_to "Plants and sites", companies_path(category: "plants") %>
      <%= link_to "Our data", data_path %>
    </nav>
    <nav class="nd-footer__col" aria-label="About">
      <h2 class="nd-footer__label">About</h2>
      <%= link_to "About", about_path %>
      <%= link_to "Our crawler", bot_path %>
      <%= link_to "Privacy", privacy_path %>
      <%= link_to "Disclaimer", disclaimer_path %>
      <%= mail_to DirectoryHelper::CORRECTIONS_EMAIL, "Contact us" %>
    </nav>
    <p class="nd-footer__count"><%= footer_counts %></p>
  </div>
  <nav class="nd-footer__links type-small" aria-label="About this site">
    <%= link_to "About", about_path, class: "nd-link nd-link--muted" %>
    <%= link_to "Our data", data_path, class: "nd-link nd-link--muted" %>
    <%= link_to "Privacy", privacy_path, class: "nd-link nd-link--muted" %>
    <%= link_to "Disclaimer", disclaimer_path, class: "nd-link nd-link--muted" %>
    <%= link_to "Our crawler", bot_path, class: "nd-link nd-link--muted" %>
    <%= mail_to DirectoryHelper::CORRECTIONS_EMAIL, "Contact us", class: "nd-link nd-link--muted" %>
  </nav>
</footer>
