<%# One company in a list. Locals:
    organization: an Organization
    connections:  number of verified links (optional)
    Empty fields (description, HQ) are left out, never guessed. %>
<% where = place(organization.hq_city, organization.hq_state) %>
<% connections = local_assigns[:connections] %>
<li>
  <%= link_to company_url_for(organization), class: "nd-listrow" do %>
    <span class="nd-mono" aria-hidden="true"><%= initials(organization.name) %></span>
    <span class="nd-listrow__main">
      <span class="nd-listrow__name" data-truncate title="<%= organization.name %>" style="--chars: <%= organization.name.length %>"><%= organization.name %></span>
      <% if organization.description.present? %><span class="nd-listrow__desc" data-truncate title="<%= organization.description %>" style="--chars: <%= organization.description.length %>"><%= organization.description %></span><% end %>
    </span>
    <% if where || connections %>
      <span class="nd-listrow__side">
        <% if where %><span><%= where %></span><% end %>
        <% if connections %><span class="nd-num"><%= pluralize(connections, "connection") %></span><% end %>
      </span>
    <% end %>
  <% end %>
</li>
