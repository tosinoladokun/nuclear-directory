<%# The site icon beside the home wordmark (#909): the favicon's square, two crossed orbits and the nucleus, the one
    atom DESIGN.md allows (Iconography). The orbits draw themselves in once when the page opens, then hold; with
    reduced motion they are simply there. Same geometry as script/build_site_icon.py. Decorative: the name is in
    text beside it. The tab icon (public/icon.svg, favicon.ico) stays still. %>
<svg class="nd-siteicon" viewBox="0 0 512 512" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  <rect class="nd-siteicon__square" width="512" height="512"/>
  <g class="nd-siteicon__orbits" fill="none" stroke-width="40">
    <ellipse class="nd-siteicon__orbit" pathLength="1" cx="256" cy="256" rx="200" ry="84" transform="rotate(45 256 256)"/>
    <ellipse class="nd-siteicon__orbit" pathLength="1" cx="256" cy="256" rx="200" ry="84" transform="rotate(-45 256 256)"/>
  </g>
  <circle class="nd-siteicon__nucleus" cx="256" cy="256" r="56"/>
</svg>
