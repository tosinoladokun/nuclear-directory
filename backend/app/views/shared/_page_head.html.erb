<%# The page head (nd-pagehead), for profiles and lists (#558). Locals:
    name:     the page name (required, one line)
    count:    the count and its noun in mono, beside the name: "42 companies" (optional)
    about:    a one-line description (optional)
    crumbs:   [[label, href], ...] (optional)
    square:   HTML for a 40px category square icon (optional); bucket: the Category that colours it
    tags:     [text, ...], or [{ text:, icon:, bucket: }, ...] for tags with an icon in their category's colour (optional) %>
<header class="nd-pagehead <%= bucket_class(bucket) if local_assigns[:bucket] %>">
  <% if local_assigns[:crumbs].present? %>
    <nav class="nd-pagehead__crumbs" aria-label="Breadcrumb"><% crumbs.each_with_index do |(label, href), i| %><%= "›" if i.positive? %> <%= link_to label, href, class: "underline" %><% end %></nav>
  <% end %>
  <div class="nd-pagehead__row">
    <% if local_assigns[:square] %><span class="nd-pagehead__square" aria-hidden="true"><%= square %></span><% end %>
    <h1 class="nd-pagehead__name type-page-name" title="<%= name %>" style="--chars: <%= name.length %>"><%= name %></h1>
    <% if local_assigns[:count] %><span class="nd-pagehead__count"><%= count %></span><% end %>
  </div>
  <% if local_assigns[:about].present? %><p class="nd-pagehead__about"><%= about %></p><% end %>
  <% if local_assigns[:tags].present? %><div class="nd-pagehead__tags"><% tags.each do |item| %>
    <% if item.is_a?(Hash) %>
      <% tag_class = "nd-tag nd-tag--icon #{bucket_class(item[:bucket]) if item[:bucket]}" %>
      <% if item[:href] %><%= link_to item[:href], class: "#{tag_class} nd-tag--link" do %><%= item[:icon] %><%= item[:text] %><% end %>
      <% else %><span class="<%= tag_class %>"><%= item[:icon] %><%= item[:text] %></span><% end %>
    <% else %><span class="nd-tag"><%= item %></span><% end %>
  <% end %></div><% end %>
</header>
