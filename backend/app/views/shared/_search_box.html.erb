<%# The search field with instant results, used on the home page (size: :large)
    and in the site header (size: :compact). Locals:
    size:  :large or :compact (default :compact)
    query: fills the field (optional)
    id:    unique id when a page has two search boxes of the same size (optional)
    browse: HomeCategories::Browse list; the empty, focused field then shows them under "Browse" (#909, home only)
    Without JavaScript it's a plain form: Enter goes to the directory's full results. %>
<% size = local_assigns.fetch(:size, :compact) %>
<% field_id = local_assigns[:id] || "search-#{size}" %>
<div class="nd-searchbox nd-searchbox--<%= size %>" data-controller="instant-search" data-instant-search-url-value="<%= search_path %>" data-instant-search-name-full-value="<%= DirectoryHelper::LINE_NAME_FULL %>" data-instant-search-name-small-value="<%= DirectoryHelper::LINE_NAME_SMALL %>" data-instant-search-index-url-value="<%= search_index_path %>" data-instant-search-all-url-value="<%= directory_url_for %>"
     data-instant-search-long-placeholder-value="Search a company, plant or site"
     data-instant-search-short-placeholder-value="Search companies and plants"
     data-instant-search-tiny-placeholder-value="Search"
     data-action="click@window->instant-search#outside">
  <form class="nd-search" action="<%= directory_url_for %>" method="get" role="search">
    <%= icon("magnifying-glass", size: size == :large ? 24 : 20) %>
    <label for="<%= field_id %>" class="sr-only">Search a company, plant or site</label>
    <input id="<%= field_id %>" type="search" role="combobox" name="q"<% if size == :large %> class="type-search-lg"<% end %> value="<%= local_assigns[:query] %>"
           placeholder="Search a company, plant or site" autocomplete="off" enterkeyhint="search"
           aria-controls="<%= field_id %>-results" aria-expanded="false" aria-haspopup="dialog" aria-autocomplete="list" aria-describedby="<%= field_id %>-status"
           data-instant-search-target="input"
           data-action="input->instant-search#search keydown->instant-search#keydown focus->instant-search#search">
  </form>
  <div id="<%= field_id %>-results" class="nd-searchbox__results" role="dialog" aria-label="Search results" data-instant-search-target="results"
       data-action="keydown->instant-search#navigate turbo:before-frame-render->instant-search#beforeRender turbo:frame-load->instant-search#loaded turbo:fetch-request-error->instant-search#failed turbo:frame-missing->instant-search#failed" hidden>
    <% if (browse = local_assigns[:browse]).present? %>
      <div class="nd-instant nd-browse" data-instant-search-target="browse" hidden>
        <div class="nd-label nd-instant__group" id="<%= field_id %>-browse">Browse</div>
        <ul class="nd-instant__list" aria-labelledby="<%= field_id %>-browse">
          <% browse.each do |row| %>
            <% noun = row.category.plants ? pluralize(row.count, "plant or site", plural: "plants and sites") : pluralize(row.count, "company", plural: "companies") %>
            <li>
              <%= link_to directory_url_for(category: row.category), class: "nd-instant__row nd-browse__row", aria: { label: "#{row.category.name}, #{noun}" }, data: { home_click: "category" } do %>
                <span class="nd-catsq <%= bucket_class(row.category) %>" aria-hidden="true"><%= bucket_icon(row.category, size: 16) %></span>
                <span class="nd-instant__text"><b class="type-body-strong"><%= row.category.name %></b></span>
                <span class="nd-browse__count type-data-sm" aria-hidden="true"><%= row.count %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <turbo-frame id="<%= field_id %>-frame" target="_top" data-instant-search-target="frame"></turbo-frame>
  </div>
  <p id="<%= field_id %>-status" class="sr-only" role="status" aria-live="polite" data-instant-search-target="status"></p>
</div>
