<%# The top of a company or power plant page. Locals:
    name:        the page's subject
    kind:        :company (initials in a square) or :plant (a ring)
    site_icon:   for a plant, its line icon's name (optional; site-plant by default)
    description: one plain line (optional; left out when unknown)
    citations:   [[number, source], ...] backing the description (optional)
    tags:        short labels, e.g. ["Reactor designer", "Fission"] (optional)
    heading_id:  the h1's id, unique on the page (optional, default "profile-name") %>
<% heading_id = local_assigns.fetch(:heading_id, "profile-name") %>
<section class="nd-profile" aria-labelledby="<%= heading_id %>">
  <% if kind == :plant %>
    <span class="nd-ring nd-ring--lg" aria-hidden="true"><%= icon(local_assigns.fetch(:site_icon, "site-plant"), set: :nd, size: 24) %></span>
  <% else %>
    <span class="nd-mono nd-mono--md" aria-hidden="true"><%= initials(name) %></span>
  <% end %>
  <div class="nd-profile__main">
    <h1 id="<%= heading_id %>" class="nd-profile__name"><%= name %></h1>
    <% if local_assigns[:description].present? %>
      <%# The last word and its source numbers stay on one line (nd-keep), so a number never starts a line alone. %>
      <% head, _, last = description.to_s.rpartition(" ") %>
      <p class="nd-profile__desc"><% if local_assigns[:citations].present? %><%= head %><%= " " if head.present? %><span class="nd-keep"><%= last %><% Array(local_assigns[:citations]).each do |number, source| %><%= render "shared/source_chip", number:, source:, compact: true %><% end %></span><% else %><%= description %><% end %></p>
    <% end %>
    <% if local_assigns[:tags].present? %>
      <div class="nd-row gap-2"><% tags.each do |tag_label| %><span class="nd-tag"><%= tag_label %></span><% end %></div>
    <% end %>
  </div>
</section>
