<%# How to cite a page, in a sunken box with a Copy button ("Copied" for two seconds). Locals: text. %>
<div class="nd-cite" data-controller="copy">
  <p class="type-body" data-copy-target="text"><%= text %></p>
  <div><button type="button" class="nd-btn nd-btn--sm" data-action="copy#copy"><span data-copy-target="label">Copy</span></button></div>
</div>
