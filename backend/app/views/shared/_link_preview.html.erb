<%# Link previews on every public page (#90). A page may set content_for
    :og_title and :og_description; otherwise the title is the page's <title>
    and the description is the site's one line. A plant, company or category
    page sets @link_card ([LinkCard, kind, key]) to its own card (#245); any
    other page shows the default card. %>
<% og_description = content_for(:og_description).presence || "Who makes the fuel, builds the reactors, runs the plants, buys the power and funds it." %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Nuclear Directory">
<meta property="og:title" content="<%= content_for(:og_title).presence || content_for(:title).presence || "Nuclear Directory" %>">
<meta property="og:description" content="<%= og_description %>">
<%# The page's own address. A category or tag is its own indexable page, so it
    keeps ?category= or ?tag=; other query strings (search, filters) are dropped. %>
<% category = Category.find(params[:category].to_s) if request.path == companies_path && params[:category].present? %>
<% list_tag = Tag.find(params[:tag].to_s) if request.path == companies_path && params[:tag].present? && !category&.plants %>
<% own = category ? { category: category.to_param } : list_tag ? { tag: list_tag.to_param } : nil %>
<meta property="og:url" content="<%= request.base_url + request.path + (own ? "?#{own.to_query}" : "") %>">
<% card, card_kind, card_key = @link_card || [ LinkCard.default, "default", nil ] %>
<meta property="og:image" content="<%= request.base_url + LinkCardsController.url_for_card(card, card_kind, card_key) %>">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="<%= LinkCard::WIDTH %>">
<meta property="og:image:height" content="<%= LinkCard::HEIGHT %>">
<meta property="og:image:alt" content="<%= card.alt %>">
<meta name="twitter:card" content="summary_large_image">
