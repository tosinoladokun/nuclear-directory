<%#
  The connections map (#363, #561): map, a ConnectionsMap. A picture and nothing to operate: no details card, no
  list, no flowing dots; each partner's name links to its own page, and "Deals and links" below lists every
  connection with its details and sources. Desktop draws a network (the server places everything;
  connections_map_controller.js fits the names and moves a colliding verb), phones get a tree. More than six plants
  fold into one node that opens in place.
%>
<% views = if map.folds? then { "folded" => map.folded, "opened" => map.opened } else { "folded" => map.edges } end %>
<section class="nd-map" aria-labelledby="connections-heading" data-controller="connections-map">
  <%= render "shared/section_head", title: "Connections", count: map.others.size, id: "connections-heading" %>
  <div class="nd-map__figure" role="group" aria-label="<%= map_summary(map) %>" data-connections-map-target="figure">
    <% views.each do |view, edges| %>
      <div class="nd-map__view" data-view="<%= view %>" data-connections-map-target="view"<%= " hidden" if view == "opened" %>>
        <% if view == "opened" %><button type="button" class="nd-map__back" data-action="connections-map#fold">‹ Back to all connections</button><% end %>

        <% prefix = "cm-#{view[0]}" %>
        <% layout = ConnectionsMap::Layout.new(edges, centre: map.centre, size: ConnectionsMap::Layout::WIDE, prefix:) %>
        <svg class="nd-map__svg" viewBox="0 0 <%= layout.width %> <%= layout.height.ceil %>" width="<%= layout.width %>" height="<%= layout.height.ceil %>"
             aria-hidden="false" data-connections-map-target="svg">
          <defs>
            <marker id="<%= prefix %>-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
              <path class="nd-map__head" d="M0 0L10 5L0 10z"></path>
            </marker>
            <% layout.groups.each do |group| %>
              <% if group.label_reversed %><path id="<%= group.id %>-rev" d="<%= group.label_reversed %>"></path><% end %>
            <% end %>
          </defs>
          <g class="nd-map__lines" aria-hidden="true">
            <% layout.groups.each do |group| %>
              <g class="nd-map__edge" data-group="<%= group.id %>">
                <% group.members.each do |member| %>
                  <path class="nd-map__line" d="<%= member.path %>"<% if member.arrow %> marker-end="url(#<%= prefix %>-arrow)"<% end %><% if !group.trunk %> id="<%= group.id %>-path"<% end %>></path>
                <% end %>
                <% if group.trunk %>
                  <path class="nd-map__line" id="<%= group.id %>-path" d="<%= group.trunk %>"<% if group.inbound %> marker-end="url(#<%= prefix %>-arrow)"<% end %>></path>
                <% end %>
              </g>
            <% end %>
          </g>
          <g class="nd-map__nodes">
            <% layout.nodes.each do |placed| %>
              <% node = placed.node %>
              <% centre = node.key == map.centre.key %>
              <% category = map.category(node) %>
              <% classes = [ "nd-map__node", ("nd-map__node--centre" if centre), ("nd-map__node--plant" if node.plant? || node.fold?), ("nd-map__node--fold" if node.fold?), (bucket_class(category) if category) ] %>
              <% inner = capture do %>
                <rect class="nd-map__ring" x="<%= (placed.x - placed.r).round(1) %>" y="<%= (placed.y - placed.r).round(1) %>" width="<%= placed.r * 2 %>" height="<%= placed.r * 2 %>" rx="<%= centre ? 8 : 6 %>"></rect>
                <% if (icon_name = map_node_icon(map, node)) %><%= map_icon(icon_name, placed.x, placed.y, centre ? 20 : 16) %><% end %>
                <text class="nd-map__name" x="<%= placed.name_x %>" y="<%= placed.name_y %>" text-anchor="<%= placed.anchor %>"
                      data-slot="<%= placed.slot %>" data-font="<%= centre ? 16 : layout.size.font %>" data-floor="<%= centre ? 16 : layout.size.floor %>"
                      data-short="<%= node.short_name if placed.name == node.name %>" style="font-size: <%= centre ? 16 : layout.size.font %>px"><%= placed.name %><title><%= node.name %></title></text>
              <% end %>
              <% if centre %>
                <g class="<%= classes.compact.join(" ") %>" data-key="<%= node.key %>"><%= inner %></g>
              <% elsif node.fold? %>
                <g class="<%= classes.compact.join(" ") %>" data-key="<%= node.key %>" role="button" tabindex="0"
                   aria-label="<%= node.name %>. Show them" data-action="click->connections-map#open keydown->connections-map#openKey"><%= inner %></g>
              <% else %>
                <a href="<%= map_node_url(node) %>" class="<%= classes.compact.join(" ") %>" data-key="<%= node.key %>" aria-label="<%= node.name %>"><%= inner %></a>
              <% end %>
            <% end %>
          </g>
          <g class="nd-map__labels" aria-hidden="true">
            <% layout.groups.each do |group| %>
              <%# The halo is its own copy behind the word: Chrome won't apply paint-order to a textPath. %>
              <text class="nd-map__halo" data-group="<%= group.id %>" dy="4"<%= raw(%( style="visibility: hidden")) if group.steep %>><textPath href="#<%= group.id %>-<%= group.label_reversed ? "rev" : "path" %>" startOffset="50%" text-anchor="middle"><%= group.verb %></textPath></text>
              <text class="nd-map__label nd-map__label--path" data-group="<%= group.id %>" data-verb="<%= group.verb %>" dy="4"<%= raw(%( style="visibility: hidden")) if group.steep %>><textPath href="#<%= group.id %>-<%= group.label_reversed ? "rev" : "path" %>" startOffset="50%" text-anchor="middle"><%= group.verb %></textPath></text>
              <text class="nd-map__label nd-map__label--flat" data-group="<%= group.id %>" data-verb="<%= group.verb %>" x="<%= group.label_at[0] %>" y="<%= group.label_at[1] + 4 %>" text-anchor="middle"<%= raw(%( style="visibility: hidden")) unless group.steep %>><%= group.verb %></text>
            <% end %>
          </g>
        </svg>
      </div>
    <% end %>

    <%# Phones: a tree. The page's record on top with a trunk down the left; one row per partner, givers first. %>
    <div class="nd-tree">
      <p class="nd-tree__centre"><span class="nd-catsq <%= bucket_class(map.category(map.centre)) if map.category(map.centre) %>" aria-hidden="true"><%= icon(map_node_icon(map, map.centre) || "site-plant", set: :nd, size: 20) %></span><b><%= map.centre.name %></b></p>
      <ol class="nd-tree__rows">
        <% map_tree_rows(map).each do |row| %>
          <% node = row.node %>
          <% category = map.category(node) %>
          <% if node.fold? %>
            <li class="nd-tree__row nd-tree__row--<%= row.inbound ? "in" : "out" %>">
              <span class="nd-tree__verb"><%= row.verb %></span><span class="nd-tree__branch" aria-hidden="true"></span>
              <details class="nd-tree__fold">
                <summary><span class="nd-catsq" aria-hidden="true"><%= icon("site-plant", set: :nd, size: 16) %></span><span class="nd-tree__name"><%= node.name %></span></summary>
                <ul class="nd-tree__plants">
                  <% node.members.sort_by { |plant| plant.name.downcase }.each do |plant| %>
                    <li><%= link_to map_node_url(plant), class: "nd-tree__node" do %><span class="nd-catsq" aria-hidden="true"><%= icon(map_node_icon(map, plant), set: :nd, size: 16) %></span><span class="nd-tree__name" title="<%= plant.name %>"><%= plant.name %></span><% end %></li>
                  <% end %>
                </ul>
              </details>
            </li>
          <% else %>
            <li class="nd-tree__row nd-tree__row--<%= row.inbound ? "in" : "out" %>">
              <span class="nd-tree__verb"><%= row.verb %></span><span class="nd-tree__branch" aria-hidden="true"></span>
              <%= link_to map_node_url(node), class: [ "nd-tree__node", (bucket_class(category) if category) ] do %><span class="nd-catsq" aria-hidden="true"><%= icon(map_node_icon(map, node) || "site-plant", set: :nd, size: 16) %></span><span class="nd-tree__name" title="<%= node.name %>"><%= node.name %></span><% end %>
            </li>
          <% end %>
        <% end %>
      </ol>
    </div>
  </div>
</section>
