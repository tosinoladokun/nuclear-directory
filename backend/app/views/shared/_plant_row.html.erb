<%# One power plant or site in a list. Locals:
    facility:    a Facility (a site). When it comes from DirectoryListing it
                 also carries units_statuses and units_capacity_mw (its
                 operating units') from its verified units.
    connections: number of verified links (optional)
    Type, status, units, capacity and place are left out when not known; a
    pending site (public for a verified unit) shows only its units' facts. %>
<% own = facility.verified? %>
<% units = units_summary(Array(facility.try(:units_statuses)), shown_status: (facility.status if own)) %>
<% capacity = facility.try(:units_capacity_mw) %>
<% kind = [ (facility_type_label(facility.facility_type) if own), (facility_status_label(facility.status) if own), units ].compact.join(" · ").presence %>
<%# Capacity is the part a narrow row drops first, so the line stays one line. %>
<% capacity_text = "#{number_with_precision(capacity, precision: 2, strip_insignificant_zeros: true, delimiter: ",")} MW" if capacity.present? %>
<% meta = [ kind, capacity_text ].compact.join(" · ").presence %>
<% where = place(facility.city, facility.state) if own %>
<% connections = local_assigns[:connections] %>
<li>
  <%= link_to plant_url_for(facility), class: "nd-listrow" do %>
    <%# The site's own type, status and reactor type only once it's verified and sourced, as on its page (PlantProfile#site_facts?). %>
    <% sourced = own && facility.try(:site_sourced) %>
    <span class="nd-ring" aria-hidden="true"><%= icon(site_icon_name((facility.facility_type if sourced),
          reactor_types: [ (facility.reactor_type if sourced), *facility.try(:units_reactor_types) ],
          status: (facility.status if sourced)), set: :nd, size: 20) %></span>
    <span class="nd-listrow__main">
      <span class="nd-listrow__name" data-truncate title="<%= facility.name %>" style="--chars: <%= facility.name.length %>"><%= facility.name %></span>
      <% if meta %><span class="nd-listrow__desc" data-truncate title="<%= meta %>" style="--chars: <%= meta.length %>"><%= kind %><% if capacity_text %><span class="nd-listrow__cap"><%= " · " if kind %><%= capacity_text %></span><% end %></span><% end %>
    </span>
    <% if where || connections %>
      <span class="nd-listrow__side">
        <% if where %><span><%= where %></span><% end %>
        <% if connections %><span class="nd-num"><%= pluralize(connections, "connection") %></span><% end %>
      </span>
    <% end %>
  <% end %>
</li>
