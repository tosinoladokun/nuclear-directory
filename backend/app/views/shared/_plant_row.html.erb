<%# One power plant or site in a list. Locals:
    facility:    a Facility (a site). When it comes from DirectoryListing it
                 also carries units_count and units_capacity_mw from its
                 verified units.
    connections: number of verified links (optional)
    Type, status, units, capacity and place are left out when not known; a
    pending site (public for a verified unit) shows only its units' facts. %>
<% own = facility.verified? %>
<% units = facility.try(:units_count).to_i %>
<% capacity = facility.try(:units_capacity_mw) %>
<% kind = [ (facility_type_label(facility.facility_type) if own), (facility_status_label(facility.status) if own),
            (pluralize(units, "unit") if units.positive?),
            ("#{number_with_precision(capacity, precision: 2, strip_insignificant_zeros: true, delimiter: ",")} MW" if capacity.present?) ].compact.join(" · ").presence %>
<% where = place(facility.city, facility.state) if own %>
<% connections = local_assigns[:connections] %>
<li>
  <%= link_to plant_url_for(facility), class: "nd-listrow" do %>
    <%# The site's own type and status are public; its reactor type only once sourced, as on its page. %>
    <span class="nd-ring" aria-hidden="true"><%= icon(site_icon_name((facility.facility_type if own),
          reactor_types: [ (facility.reactor_type if own && facility.try(:site_sourced)), *facility.try(:units_reactor_types) ],
          status: (facility.status if own)), set: :nd, size: 20) %></span>
    <span class="nd-listrow__main">
      <span class="nd-listrow__name"><%= facility.name %></span>
      <% if kind %><span class="nd-listrow__desc"><%= kind %></span><% end %>
    </span>
    <% if where || connections %>
      <span class="nd-listrow__side">
        <% if where %><span><%= where %></span><% end %>
        <% if connections %><span class="nd-num"><%= pluralize(connections, "connection") %></span><% end %>
      </span>
    <% end %>
  <% end %>
</li>
