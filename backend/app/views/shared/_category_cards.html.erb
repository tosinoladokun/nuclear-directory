<%# The home page's category cards (#362): a 2-column grid (960px at most) on wide screens, an open stack on phones. Locals:
    cards: HomeCategories::Card list (buckets with companies, then Plants and sites)
    The card's title is its link to the full list, with the count beside it (wide screens); the rows name three companies. Every
    line is one line (Tosin's rule, #365). On phones the catstack controller adds a caret button beside the title that opens and
    closes the card (all open at first, the choice remembered). Without JavaScript every card is open. Short cards get empty
    filler rows on wide screens, so cards in a row match; phones drop them. %>
<div class="nd-catgrid nd-catstack <%= local_assigns[:grid_class] %>" data-controller="catstack">
  <button type="button" class="nd-catstack__all" data-catstack-target="all" data-action="catstack#toggleAll" hidden>Collapse all</button>
  <% cards.each do |card| %>
    <% category = card.category %>
    <% noun = category.plants ? pluralize(card.count, "plant or site", plural: "plants and sites") : pluralize(card.count, "company", plural: "companies") %>
    <%# The card's title is the category's own name (Tosin, 2 Nov): one name for the title, the aria labels and the links. %>
    <% label = category.name %>
    <% head_name = "#{label}, #{noun}" %>
    <section class="nd-catcard nd-catcard--rows nd-catcard--compact nd-catcard--stack <%= bucket_class(category) %>" aria-label="<%= label %>"
             data-catstack-target="card" data-key="<%= category.key %>" data-name="<%= label %>">
      <h2 class="nd-catcard__head" data-catstack-target="head">
        <%= link_to directory_url_for(category:), class: "nd-catcard__link", title: label, aria: { label: head_name } do %>
          <%= bucket_icon(category, size: 24) %>
          <%# A category name is one we write, so it fits: no ellipsis, no data-truncate (DESIGN.md rule 5). %>
          <span class="nd-catcard__name"><%= label %></span><span class="nd-catcard__count" aria-hidden="true"><%= card.count %></span>
        <% end %>
      </h2>
      <div class="nd-catcard__body" id="cat-body-<%= category.key %>">
        <div class="nd-catcard__inner">
          <ul class="nd-catcard__rows">
            <% card.records.each do |record| %>
              <li>
                <%= link_to (category.plants ? plant_url_for(record) : company_url_for(record)), class: "nd-catcard__row", title: record.name do %>
                  <span class="nd-catcard__rowname" data-truncate title="<%= record.name %>" style="--chars: <%= record.name.length %>"><%= record.name %></span>
                <% end %>
              </li>
            <% end %>
            <% (HomeCategories::SHOWN - card.records.size).times do %><li class="nd-catcard__filler" aria-hidden="true"></li><% end %>
          </ul>
        </div>
      </div>
    </section>
  <% end %>
</div>
