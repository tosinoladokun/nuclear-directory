<% content_for :title, "Correction sent · Nuclear Directory" %>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<%= render "shared/site_header" %>

<main class="nd-page nd-page--narrow">
  <div class="nd-confirm" role="status">
    <span class="nd-ring" aria-hidden="true"><%= icon("check", size: 20) %></span>
    <div>
      <h1 class="type-title-md m-0">Correction sent</h1>
      <p class="type-body m-0">We'll review it against the source.</p>
    </div>
  </div>
  <p class="type-body m-0"><%= link_to @back, @page_path, class: "nd-link" %></p>
</main>
