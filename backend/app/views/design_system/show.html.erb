<% content_for :title, "Design system · Nuclear Directory" %>
<%# Every component from DESIGN.md with real markup. Organizations and figures are sample data. %>

<main class="mx-auto max-w-content px-4 md:px-8 py-12 flex flex-col gap-16">
  <header class="flex flex-col gap-4 max-w-prose">
    <span class="type-label">Nuclear Directory · design system</span>
    <h1 class="type-display">The US nuclear industry, mapped</h1>
    <p class="type-numeral m-0" aria-hidden="true">404</p>
    <p class="type-small text-ink-muted m-0"><code class="type-data-sm">type-numeral</code>: the 404 page's numeral only (see DESIGN.md, Type).</p>
    <p class="type-body text-ink-muted">Every component, built from the tokens in <code class="type-data">app/assets/tailwind/design_system</code>. Rules for using them are in <code class="type-data">DESIGN.md</code>. Organizations and numbers on this page are sample data.</p>
  </header>

  <section class="flex flex-col gap-4" id="type">
    <h2 class="type-title-md">Type</h2>
    <div class="flex flex-col gap-3 border-t border-rule pt-4">
      <p class="type-title-lg">Kairos Power</p>
      <p class="type-title-md">Relationships</p>
      <p class="type-body max-w-prose">Develops fluoride salt-cooled high-temperature reactors. Building the Hermes demonstration reactor in Oak Ridge, Tennessee.</p>
      <p class="type-ui">Show 214 organizations</p>
      <p class="type-small text-ink-muted">Alameda, CA · Founded 2016</p>
      <p class="type-label">Role</p>
      <p class="type-data">05000424 · 1,150 MW · 2026-10-09</p>
    </div>
  </section>

  <section class="flex flex-col gap-4" id="buttons">
    <h2 class="type-title-md">Button</h2>
    <div class="nd-row">
      <button class="nd-btn nd-btn--primary" type="button">Suggest an organization</button>
      <button class="nd-btn" type="button"><%= icon("flag") %>Report a correction</button>
      <button class="nd-btn nd-btn--ghost" type="button"><%= icon("link") %>View sources</button>
      <button class="nd-btn nd-btn--sm" type="button"><%= icon("download-simple", size: 12) %>Export CSV</button>
    </div>
  </section>

  <section class="flex flex-col gap-4" id="search">
    <h2 class="type-title-md">SearchField and AZIndex</h2>
    <label class="nd-search" for="design-q">
      <%= icon("magnifying-glass", size: 20) %>
      <input id="design-q" type="search" placeholder="Search organizations, facilities, technologies">
      <kbd>/</kbd>
    </label>
    <div class="nd-suggest">Try <a href="#">HALEU suppliers</a> <a href="#">data center offtake</a> <a href="#">fusion investors</a> <a href="#">Vogtle</a></div>
    <nav class="nd-az" aria-label="Browse A to Z">
      <% [ "#", *("A".."Z") ].each do |letter| %>
        <a href="#" <%= 'aria-current="true"'.html_safe if letter == "K" %> <%= 'aria-disabled="true"'.html_safe if %w[Q Y Z].include?(letter) %>><%= letter %></a>
      <% end %>
    </nav>
  </section>

  <section class="flex flex-col gap-4" id="directory">
    <h2 class="type-title-md">FilterBar, OrgCard and DirectoryTable</h2>
    <div class="nd-filterbar">
      <div class="nd-row" role="group" aria-label="Role">
        <% [ [ "All", 214, true ], [ "Fuel", 18 ], [ "Reactor vendor", 41 ], [ "Reactor services", 37 ], [ "Utility", 29 ], [ "Data center offtaker", 12 ], [ "Investor", 33 ] ].each do |name, count, on| %>
          <button class="nd-chip" aria-pressed="<%= on ? true : false %>" type="button"><%= name %> <span class="nd-num"><%= count %></span></button>
        <% end %>
      </div>
      <div class="nd-filterbar__top">
        <div class="nd-row">
          <span class="nd-select"><%= icon("sliders-horizontal") %><b>Technology</b> Fission, SMR <%= icon("caret-down", size: 12) %></span>
          <span class="nd-select"><b>State</b> Any <%= icon("caret-down", size: 12) %></span>
          <span class="type-small text-ink-muted">214 organizations</span>
        </div>
        <div class="nd-toggle" role="group" aria-label="View">
          <button aria-pressed="true" type="button"><%= icon("squares-four", size: 12) %>Cards</button><button aria-pressed="false" type="button"><%= icon("list", size: 12) %>Table</button>
        </div>
      </div>
    </div>

    <% orgs = [
         { initials: "KP", name: "Kairos Power", place: "Alameda, CA", founded: 2016, role: "Reactor vendor", tech: %w[Fission SMR], rels: 14, checked: "2026-10-02", verified: true,
           desc: "Develops fluoride salt-cooled high-temperature reactors. Building the Hermes demonstration reactor in Oak Ridge, Tennessee." },
         { initials: "CE", name: "Centrus Energy", place: "Bethesda, MD", founded: 1998, role: "Fuel", tech: %w[Fission], rels: 9, checked: "2026-09-28", verified: true,
           desc: "Supplies nuclear fuel and enrichment services. Operates a HALEU enrichment cascade in Piketon, Ohio." },
         { initials: "SN", name: "Southern Nuclear", place: "Birmingham, AL", founded: 1990, role: "Operator", tech: %w[Fission], rels: 22, checked: "2026-10-05", verified: true,
           desc: "Operates nuclear plants for Southern Company, including all four units at Plant Vogtle in Georgia." },
         { initials: "XE", name: "X-energy", place: "Rockville, MD", founded: 2009, role: "Reactor vendor", tech: %w[Fission SMR], rels: 11, checked: "2026-10-01", verified: false,
           desc: "Develops the Xe-100 high-temperature gas-cooled small modular reactor and TRISO-X fuel." }
       ] %>
    <div class="nd-cards">
      <% orgs.first(3).each do |org| %>
        <a class="nd-card" href="#">
          <div class="nd-card__head">
            <span class="nd-mono"><%= org[:initials] %></span>
            <div><div class="nd-card__name"><%= org[:name] %></div><div class="nd-card__meta"><%= icon("map-pin", size: 12) %><%= org[:place] %> · Founded <%= org[:founded] %></div></div>
          </div>
          <p class="nd-card__desc"><%= org[:desc] %></p>
          <div class="nd-row"><span class="nd-tag"><%= org[:role] %></span><% org[:tech].each do |t| %><span class="nd-tag"><%= t %></span><% end %></div>
          <div class="nd-card__foot"><span><%= org[:rels] %> relationships</span><span>checked <%= org[:checked] %></span></div>
        </a>
      <% end %>
    </div>

    <div class="nd-table-wrap">
      <table class="nd-table">
        <thead><tr><th>Organization</th><th>Role</th><th>Technology</th><th>HQ</th><th class="nd-r">Relationships</th><th>Status</th></tr></thead>
        <tbody>
          <% orgs.each do |org| %>
            <tr>
              <td><span class="nd-org"><span class="nd-mono"><%= org[:initials] %></span><span class="type-body-strong"><%= org[:name] %></span></span></td>
              <td><%= org[:role] %></td>
              <td class="nd-muted"><%= org[:tech].join(" · ") %></td>
              <td class="nd-muted"><%= org[:place] %></td>
              <td class="nd-num"><%= org[:rels] %></td>
              <td>
                <% if org[:verified] %>
                  <span class="nd-badge nd-badge--verified"><%= icon("check", weight: :bold, size: 12) %>Verified</span>
                <% else %>
                  <span class="nd-badge nd-badge--pending"><%= icon("clock", size: 12) %>Pending</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="flex flex-col gap-4" id="empty">
    <h2 class="type-title-md">EmptyState</h2>
    <div class="nd-empty">
      <%= icon("magnifying-glass", size: 24) %>
      <h3>Nothing matches “molten salt pump suppliers” yet</h3>
      <p>We add organizations as we verify them. Know one? Suggest it and we’ll look for public sources before it goes live.</p>
      <button class="nd-btn nd-btn--primary" type="button">Suggest an organization</button>
    </div>
  </section>

  <section class="flex flex-col gap-4" id="profile">
    <h2 class="type-title-md">ProfileHeader, Tabs, OverviewPanel and SourceChip</h2>
    <header class="nd-banner">
      <span class="nd-mono nd-mono--lg">KP</span>
      <h3 class="nd-banner__name">Kairos Power</h3>
      <p class="nd-banner__desc">Develops fluoride salt-cooled high-temperature reactors. Building the Hermes demonstration reactor in Oak Ridge, Tennessee.</p>
      <div class="nd-row"><span class="nd-tag">Reactor vendor</span><span class="nd-tag">Fission</span><span class="nd-tag">SMR</span></div>
      <div class="nd-banner__actions">
        <button class="nd-btn" type="button"><%= icon("graph", weight: :bold) %>View relationship map</button>
        <button class="nd-btn nd-btn--ghost" type="button"><%= icon("flag", weight: :bold) %>Report a correction</button>
      </div>
    </header>
    <div class="nd-tabs" role="tablist">
      <button role="tab" aria-selected="true" type="button">Overview</button>
      <button role="tab" aria-selected="false" type="button">Relationships<span class="nd-num">14</span></button>
      <button role="tab" aria-selected="false" type="button">Facilities<span class="nd-num">1</span></button>
      <button role="tab" aria-selected="false" type="button">Sources<span class="nd-num">9</span></button>
    </div>
    <div class="flex flex-col md:flex-row gap-8 items-start">
      <div class="flex flex-col gap-4 max-w-prose min-w-0">
        <div class="nd-fact">Signed an agreement to supply up to 500 MW of power to Google from a fleet of small reactors.<a class="nd-src" href="#"><sup>1</sup>blog.google <span class="nd-src__checked">· checked 2026-10-02</span><%= icon("arrow-square-out", size: 12) %></a></div>
        <div class="nd-fact">Building the Hermes demonstration reactor in Oak Ridge, Tennessee.<a class="nd-src" href="#"><sup>2</sup>nrc.gov</a><a class="nd-src" href="#"><sup>3</sup>energy.gov</a></div>
        <div class="nd-row">
          <span class="nd-badge nd-badge--verified"><%= icon("check", weight: :bold, size: 12) %>Verified</span>
          <span class="nd-badge nd-badge--pending"><%= icon("clock", size: 12) %>Pending review</span>
          <span class="nd-badge nd-badge--rejected"><s>Supplies</s> <%= icon("x", weight: :bold, size: 12) %>Rejected</span>
        </div>
        <div class="nd-row gap-6">
          <% [ [ 3, "High · 3 sources" ], [ 2, "Medium · 2 sources" ], [ 1, "Low · 1 source" ] ].each do |on, text| %>
            <span class="nd-conf"><span class="nd-conf__bars"><% 3.times do |i| %><i class="<%= 'on' if i < on %>"></i><% end %></span><%= text %></span>
          <% end %>
        </div>
      </div>
      <aside class="nd-overview">
        <h3>Overview</h3>
        <dl>
          <dt>Website</dt><dd>kairospower.com</dd>
          <dt>HQ</dt><dd>Alameda, CA<a class="nd-src" href="#"><sup>1</sup></a></dd>
          <dt>Founded</dt><dd class="nd-num">2016<a class="nd-src" href="#"><sup>1</sup></a></dd>
          <dt>Role</dt><dd>Reactor vendor</dd>
          <dt>Tech</dt><dd>Fluoride salt-cooled, high-temperature (KP-FHR)<a class="nd-src" href="#"><sup>2</sup></a></dd>
        </dl>
        <div class="nd-overview__foot">
          <span class="nd-badge nd-badge--verified"><%= icon("check", weight: :bold, size: 12) %>Verified</span>
          <span class="type-data-sm text-ink-muted">checked 2026-10-02</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="flex flex-col gap-4" id="graph">
    <h2 class="type-title-md">RelationshipGraph</h2>
    <div class="nd-graph">
      <svg viewBox="0 0 520 320" role="img" aria-label="Relationship map for Kairos Power, sample data">
        <line class="edge hot" x1="260" y1="160" x2="110" y2="70"/>
        <line class="edge hot offtake" x1="260" y1="160" x2="420" y2="70"/>
        <line class="edge hot invest" x1="260" y1="160" x2="90" y2="230"/>
        <line class="edge hot" x1="260" y1="160" x2="430" y2="240"/>
        <line class="edge" x1="110" y1="70" x2="90" y2="230"/>
        <line class="edge" x1="430" y1="240" x2="470" y2="150"/>
        <line class="edge invest" x1="420" y1="70" x2="470" y2="150"/>
        <circle class="ring" cx="260" cy="160" r="15"/>
        <circle class="org sel" cx="260" cy="160" r="11"/>
        <text class="lbl sel" x="260" y="194" text-anchor="middle">Kairos Power</text>
        <circle class="org" cx="110" cy="70" r="6"/><text class="lbl" x="110" y="54" text-anchor="middle">Supplier</text>
        <circle class="org" cx="420" cy="70" r="6"/><text class="lbl" x="420" y="54" text-anchor="middle">Google</text>
        <circle class="org" cx="90" cy="230" r="6"/><text class="lbl" x="90" y="254" text-anchor="middle">Investor</text>
        <circle class="fac" cx="430" cy="240" r="6"/><text class="lbl" x="430" y="264" text-anchor="middle">Hermes, Oak Ridge TN</text>
        <circle class="org" cx="470" cy="150" r="4"/>
        <text class="elbl" x="352" y="104">offtake</text>
        <text class="elbl" x="352" y="216">owns</text>
      </svg>
      <div class="nd-graph__panel">
        <span class="nd-label">Selected</span>
        <h4>Kairos Power</h4>
        <div class="type-small text-ink-muted">Reactor vendor · Alameda, CA</div>
        <div class="type-data">4 direct · 7 within 2 steps</div>
        <a class="nd-btn nd-btn--sm self-start" href="#">Open profile<%= icon("arrow-right", size: 12) %></a>
        <div class="nd-graph__legend">
          <span><svg viewBox="0 0 28 8" aria-hidden="true"><circle cx="4" cy="4" r="3.5" fill="currentColor"/></svg>Organization</span>
          <span><svg viewBox="0 0 28 8" aria-hidden="true"><circle cx="4" cy="4" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>Facility</span>
          <span><svg viewBox="0 0 28 8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="currentColor"/></svg>Supplies · owns · operates</span>
          <span><svg viewBox="0 0 28 8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="currentColor" stroke-dasharray="4 4"/></svg>Invests in</span>
          <span><svg viewBox="0 0 28 8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" stroke="currentColor" stroke-dasharray="1 3" stroke-linecap="round"/></svg>Offtakes from</span>
        </div>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-6" id="page-parts">
    <div class="flex flex-col gap-1">
      <h2 class="type-title-md">Page parts (shared partials)</h2>
      <p class="type-small text-ink-muted">Rendered from <code class="type-data-sm">app/views/shared/</code> with mock records (unsaved, this page only). Each part appears with its optional fields filled and again with them empty.</p>
    </div>
    <% m = @mock %>

    <div class="flex flex-col gap-2">
      <span class="type-label">Site header: with a query, then empty</span>
      <div class="border border-rule"><%= render "shared/site_header", query: "haleu" %></div>
      <div class="border border-rule"><%= render "shared/site_header", search_id: "search-compact-empty" %></div>
    </div>

    <div class="flex flex-col gap-2">
      <span class="type-label">Site footer, and a short fixed page (nd-prose with nd-code)</span>
      <div class="border border-rule"><%= render "shared/site_footer" %></div>
      <div class="border border-rule nd-prose flex flex-col p-4">
        <h3 class="type-title-md">NuclearDirectoryBot</h3>
        <p class="type-body"><strong>In short:</strong> an optional one-line summary (VOICE.md, "Prose has structure").</p>
        <section class="flex flex-col gap-2">
          <h4 class="type-body-strong">How to block it</h4>
          <p class="type-body">A topic heading, then a short lead sentence.</p>
          <ul class="type-body">
            <li>Then the details as a list, one fact per bullet.</li>
          </ul>
          <pre class="nd-code type-data">User-agent: NuclearDirectoryBot
Disallow: /</pre>
        </section>
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <span class="type-label">Category pills (with and without counts) and boxes</span>
      <%= render "shared/category_pills", current: Category.find("reactor-developers"), counts: { "fuel" => 11, "reactor-developers" => 9, "plants" => 28 } %>
      <%= render "shared/category_pills", current: nil %>
      <%= render "shared/category_boxes", examples: { "fuel" => [ "Centrus Energy", "Urenco USA" ], "reactor-developers" => [ "Kairos Power", "X-energy", "TerraPower" ] } %>
    </div>

    <div class="flex flex-col gap-2">
      <span class="type-label">Company and power plant rows: full, then sparse</span>
      <ul class="nd-list">
        <%= render "shared/company_row", organization: m[:company], connections: 6 %>
        <%= render "shared/company_row", organization: m[:company_sparse] %>
        <%= render "shared/plant_row", facility: m[:plant], connections: 9 %>
        <%= render "shared/plant_row", facility: m[:plant_sparse] %>
      </ul>
    </div>

    <div class="flex flex-col gap-2">
      <span class="type-label">Profile header: company with description, plant without</span>
      <%= render "shared/profile_header", name: m[:company].name, kind: :company, description: m[:company].description,
            citations: [ [ 1, m[:sources][0] ] ], tags: [ "Reactor developer", "Molten salt coolant", "Fission" ], heading_id: "design-profile-company" %>
      <%= render "shared/profile_header", name: m[:plant_sparse].name, kind: :plant, heading_id: "design-profile-plant" %>
    </div>

    <div class="nd-columns">
      <div class="nd-columns__main">
        <section>
          <h3 class="nd-sec-h">Deals and links <small>full, then sentence and source only</small></h3>
          <ul class="nd-list">
            <%= render "shared/fact_row",
                  sentence: safe_join([ link_to("Google", "#", class: "nd-link type-body-strong"), " #{relationship_verb("offtake_with")} Kairos Power" ]),
                  detail: "Master Plant Development Agreement for 500 MW of Kairos plants by 2035. October 2024.",
                  quote: "Kairos Power and Google have signed a Master Plant Development Agreement, creating a path to deploy a U.S. fleet of advanced nuclear power projects totaling 500 MW by 2035.",
                  citations: [ [ 1, m[:sources][0] ] ], confidence: 1.0, checked: m[:verified_at] %>
            <%= render "shared/fact_row",
                  sentence: safe_join([ link_to("US Department of Energy", "#", class: "nd-link type-body-strong"), " #{relationship_verb("funds")} Kairos Power" ]),
                  citations: [ [ 2, m[:sources][1] ] ] %>
          </ul>
        </section>
        <%= render "shared/missing_fields", fields: [ "Location", "Status", "Reactor units and capacity", "NRC docket numbers" ], suggest_url: "#" %>
        <section>
          <h3 class="nd-sec-h">Sources <small>2 (the second has no title)</small></h3>
          <%= render "shared/sources_list", sources: m[:sources].each_with_index.map { |source, i| [ i + 1, source ] } %>
        </section>
        <div class="flex flex-col">
          <span class="type-label">Empty state: with an action, then without</span>
          <%= render "shared/empty_state", message: "No results for “molten salt pump” in Developers.", action_label: "Clear search", action_url: "#" %>
          <%= render "shared/empty_state", message: "Nothing verified in this category yet." %>
        </div>
        <div class="flex flex-col gap-2">
          <span class="type-label">Verified badge: with a checked date, then without</span>
          <div class="nd-row"><%= render "shared/verified_badge", verified_at: m[:verified_at] %></div>
          <div class="nd-row"><%= render "shared/verified_badge" %></div>
        </div>
      </div>
      <div class="nd-columns__side">
        <%= render "shared/overview_panel", verified_at: m[:verified_at], correction_url: "#",
              rows: [ [ "Website", link_to("kairospower.com", "#", class: "nd-link"), nil ],
                      [ "HQ", nil, nil ],
                      [ "Role", "Reactor developer", [ [ 1, m[:sources][0] ] ] ],
                      [ "Technology", "Fission, small modular reactor", nil ] ] %>
        <%= render "shared/overview_panel", rows: [ [ "Website", nil, nil ] ] %>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-6" id="admin">
    <h2 class="type-title-md">Admin (#86)</h2>
    <p class="type-small text-ink-muted m-0">Only behind sign-in. Desktop-first; on phones the bulk bar and checkboxes are hidden and buttons are 44px tall.</p>

    <div class="flex flex-col gap-3">
      <div class="nd-flash" role="status"><p class="type-body">Approved 3 items.</p></div>
      <div class="nd-flash" role="alert"><%= icon("warning-circle") %><p class="type-body-strong">Claim 12: TerraPower was unpublished by human:tosin; not changed.</p></div>
    </div>

    <div class="nd-stack max-w-prose">
      <div class="nd-field">
        <label for="design-field" class="type-ui">Reason <span class="type-small text-ink-muted">(optional, kept in the record's history)</span></label>
        <input id="design-field" class="nd-input type-input" type="text" value="NRC lists the nearby city's state">
      </div>
      <label class="nd-row type-ui"><input type="checkbox" class="nd-check" checked> Select all on this page</label>
    </div>

    <div class="nd-bulk">
      <label class="type-ui"><input type="checkbox" class="nd-check"> Select all on this page</label>
      <span class="nd-row"><span class="type-small text-ink-muted">2 selected</span><button class="nd-btn nd-btn--primary nd-btn--sm" type="button">Approve selected</button></span>
    </div>
    <ol class="nd-items">
      <li class="nd-item">
        <div class="nd-item__select"><input type="checkbox" class="nd-check" aria-label="Select claim 7"></div>
        <div class="nd-item__main">
          <p class="nd-item__claim type-body-strong">There is a plant named “Hope Creek 1”, with NRC docket 05000354 and state DE.</p>
          <blockquote class="nd-quote">“Hope Creek 1 | 05000354 | NPF-57 | BWR | 18 miles SE of Wilmington, DE”</blockquote>
          <div class="nd-item__meta type-small"><a class="nd-link nd-link--muted" href="#">List of Power Reactor Units <%= icon("arrow-square-out", size: 12) %></a><span>Found by <span class="nd-num">openai/gpt-6-luna</span></span><span class="nd-num">Claim 7</span><a class="nd-link nd-link--muted" href="#">Open record</a></div>
          <p class="nd-item__why type-body"><strong>Why it's here:</strong> Human-verified state is NJ; this source says DE</p>
          <div class="nd-table-wrap">
            <table class="nd-table">
              <thead><tr><th scope="col">Field</th><th scope="col">Human-verified</th><th scope="col">This source</th></tr></thead>
              <tbody><tr><th scope="row" class="type-small">State</th><td>NJ</td><td>DE</td></tr></tbody>
            </table>
          </div>
          <div class="nd-item__actions">
            <button class="nd-btn nd-btn--primary nd-btn--sm" type="button">Approve</button>
            <a class="nd-btn nd-btn--sm" href="#">Edit, then approve</a>
            <details><summary class="nd-btn nd-btn--sm">Reject…</summary></details>
          </div>
        </div>
      </li>
    </ol>

    <dl class="nd-kv type-body">
      <dt class="type-label">NRC docket</dt><dd class="nd-num">05000354</dd>
      <dt class="type-label">State</dt><dd>NJ</dd>
      <dt class="type-label">Description</dt><dd><span class="text-ink-muted">Not set</span></dd>
    </dl>
    <div class="nd-row">
      <span class="nd-badge nd-badge--pending">Unpublished</span>
      <span class="type-small text-ink-muted">by human:tosin on <span class="nd-num">2026-10-10</span></span>
    </div>
  </section>

  <section class="flex flex-col gap-4" id="icons">
    <h2 class="type-title-md">Icons (Phosphor)</h2>
    <div class="grid gap-3" style="grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));">
      <% %w[magnifying-glass sliders-horizontal graph buildings factory link arrow-square-out check clock x map-pin coins plug flag download-simple warning-circle].each do |name| %>
        <div class="flex items-center gap-2 type-data-sm text-ink-muted"><span class="text-ink flex gap-1"><%= icon(name, size: 20) %><%= icon(name, weight: :bold, size: 20) %></span><%= name %></div>
      <% end %>
    </div>
  </section>
</main>
