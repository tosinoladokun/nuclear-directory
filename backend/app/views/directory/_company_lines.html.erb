<%# The companies of a list as one white panel of rows: name · description · location (#560).
    Locals: companies (each with its hq place), short ({ id => the middle text }, ShortDescription.for). %>
<ul class="nd-lines">
  <% companies.each do |company| %>
    <%= render "shared/line", variant: :bare, href: company_url_for(company), name: company.name, short_name: company.short_name, what: short[company.id],
          place: company_place(company) %>
  <% end %>
</ul>
