<%
  listing = @listing
  # A bucket's page, or a tag's (/companies?tag=fusion, #281): each has its
  # own heading, title, description and canonical address.
  list_page = listing.category || listing.tag
  heading = if list_page then list_page.name
            elsif listing.searching? then "Results for “#{listing.query}”"
            else "All companies"
            end
  total = @companies_total + @plants_total
  more = @companies_total > @companies.size || @plants_total > @plants.size
  # The plants category mixes plants, mines and test reactors (VOICE.md).
  noun, plural = if listing.category&.plants then [ "plant or site", "plants and sites" ]
                 elsif listing.searching? && list_page.nil? then [ "result", "results" ]
                 else [ "company", "companies" ]
                 end
  # A category's title and description use the words people search with,
  # and the description gives its count (#290); the heading stays short.
  category_page = list_page && !listing.searching?
  # A tag's title ends " | Nuclear Directory" ("SMR companies in the US | Nuclear Directory", #606).
  content_for :title, listing.tag && category_page ? "#{list_page.title} | Nuclear Directory" : "#{category_page ? list_page.title : heading} · Nuclear Directory"
  # The count of what this page lists (a state or technology filter narrows it).
  description = if category_page then list_page.description(total)
                elsif listing.searching? then "Companies and plants matching “#{listing.query}”."
                else "#{heading} in the US nuclear industry."
                end
  # A shared category or listing previews with its own line, not the home page's (#246).
  content_for :og_description, description
  # A category page shows its own preview image; a search or "All companies", the default (#245).
  @link_card = [ LinkCard.for_category(listing.category, @counts.fetch(listing.category.key)), "categories", listing.category.key ] if @counts && listing.category && !listing.searching? && !listing.filtered?
%>
<% content_for :head do %>
  <%# /companies only: its heading is the LCP and the serif was fetched only once the text was laid out (LCP ~0.2 s sooner). Not on the home page, where a preload shared bandwidth with the CSS and cost LCP 0.4 s. %>
  <link rel="preload" as="font" type="font/woff2" crossorigin href="<%= asset_path "roboto-serif-latin.woff2" %>">
  <meta name="description" content="<%= description %>">
  <% if listing.searching? || listing.filtered? || @shown > DirectoryController::PAGE %><meta name="robots" content="noindex"><% end %>
  <%# Search and filters point back to the plain list or category. %>
  <link rel="canonical" href="<%= listing.category ? companies_url(category: listing.category.to_param) : listing.tag ? companies_url(tag: listing.tag.to_param) : companies_url %>">
<% end %>
<%= render "shared/site_header", query: listing.query %>

<%
  index_items = [ { label: "All companies", href: directory_url_for, icon: icon("list"), count: @all_count, current: list_page.nil? && !listing.searching?, title: "All companies" } ]
  Category.all.each do |category|
    break unless @counts
    count = @counts[category.key]
    next if !category.plants && count&.zero? && listing.category != category
    index_items << { label: category.list_name, title: category.name, href: directory_url_for(category:), icon: bucket_icon(category),
                     count:, bucket: (category unless category.plants), current: listing.category == category }
  end
  page_noun = noun
%>
<main class="nd-page nd-page--wide">
  <div class="nd-listpage">
    <% if @counts %>
      <div class="nd-listpage__index"><%= render "shared/index", items: index_items, variant: :list, label: "Categories" %></div>
      <%# Phones: the same categories as one scrolling row, opened with the current one in view. %>
      <div class="nd-chips nd-listpage__chips" data-controller="pill-row" role="navigation" aria-label="Categories">
        <%= render "shared/chip", label: "All companies", href: directory_url_for, icon: icon("list"), count: @all_count, current: list_page.nil? && !listing.searching? %>
        <% Category.all.each do |category| %>
          <% next if !category.plants && @counts[category.key]&.zero? && listing.category != category %>
          <%= render "shared/chip", label: category.name, href: directory_url_for(category:), icon: bucket_icon(category), count: @counts[category.key], bucket: (category unless category.plants), current: listing.category == category %>
        <% end %>
      </div>
    <% end %>

  <div class="nd-listpage__main">
  <%= render "shared/page_head", name: heading, count: pluralize(total, noun, plural:), about: (list_page.description(1) if category_page),
        square: (bucket_icon(listing.category, size: 24) if listing.category), bucket: (listing.category unless listing.category&.plants) %>

  <div class="nd-listhead nd-listhead--bare">
    <%# On phones the filters open in a full-screen sheet behind "Filters (N)"
        (#90). Without JavaScript the sheet is a native popover the button
        opens and closes on its own; with it, the same contents open in a
        modal <dialog> (page behind inert) with a live "Show N results". On
        wide screens, and without popover support, the form shows inline. %>
    <% active = [ listing.technology, listing.state ].compact.size %>
    <div class="nd-filterwrap" data-controller="filter-sheet" data-filter-sheet-count-url-value="<%= companies_path(format: :json) %>"
         data-action="turbo:before-cache@document->filter-sheet#close">
      <%# On phones Sort sits beside Filters, outside the sheet; it applies as it changes. %>
      <%= form_with url: companies_path, method: :get, class: "nd-sortbar", data: { controller: "auto-submit" } do %>
        <%= hidden_field_tag :category, listing.category&.key, id: nil if listing.category %>
        <%= hidden_field_tag :tag, listing.tag.key, id: nil if listing.tag %>
        <%= hidden_field_tag :role, listing.role, id: nil if listing.role %>
        <%= hidden_field_tag :q, listing.query, id: nil if listing.searching? %>
        <%= hidden_field_tag :technology, listing.technology, id: nil if listing.technology %>
        <%= hidden_field_tag :state, listing.state, id: nil if listing.state %>
        <label class="nd-select"><b>Sort</b>
          <%= select_tag :sort, options_for_select(DirectoryListing::SORTS.invert, listing.sort), id: "sort-phone", class: "type-input", data: { action: "change->auto-submit#submit" } %>
        </label>
        <noscript><button type="submit" class="nd-btn nd-btn--sm">Apply</button></noscript>
      <% end %>
      <button type="button" class="nd-btn nd-btn--sm nd-filterwrap__open" popovertarget="filter-sheet" popovertargetaction="show" data-action="filter-sheet#open">
        <%= icon("sliders-horizontal") %>Filters<% if active.positive? %> <span class="type-data">(<%= active %>)</span><% end %>
      </button>
      <div id="filter-sheet" class="nd-filtersheet" popover role="group" aria-labelledby="filters-title"
           data-filter-sheet-target="sheet" data-action="toggle->filter-sheet#toggled">
        <div class="nd-filtersheet__head">
          <h2 id="filters-title" class="type-body-strong">Filters</h2>
          <button type="button" class="nd-btn nd-btn--ghost nd-btn--sm" popovertarget="filter-sheet" popovertargetaction="hide" data-action="filter-sheet#close">Close filters</button>
        </div>
        <%= form_with url: companies_path, method: :get, class: "nd-filters", data: { filter_sheet_target: "form", action: "change->filter-sheet#count" } do %>
          <%= hidden_field_tag :category, listing.category&.key, id: nil if listing.category %>
          <%= hidden_field_tag :tag, listing.tag.key, id: nil if listing.tag %>
          <%# A category's role (Reactor designer, Project developer) stays through the filters and their count. %>
          <%= hidden_field_tag :role, listing.role, id: nil if listing.role %>
          <%= hidden_field_tag :q, listing.query, id: nil if listing.searching? %>
          <%# Filtering a suggested search is still that search (from=suggestion), not new typing. %>
          <%= hidden_field_tag :from, "suggestion", id: nil if listing.searching? && params[:from] == "suggestion" %>
          <label class="nd-select"><b>Technology</b>
            <%= select_tag :technology, options_for_select(listing.technology_options, listing.technology), include_blank: "Any", class: "type-input" %>
          </label>
          <label class="nd-select"><b>State</b>
            <%= select_tag :state, options_for_select(listing.state_options, listing.state), include_blank: "Any", class: "type-input" %>
          </label>
          <label class="nd-select nd-select--sort"><b>Sort</b>
            <%= select_tag :sort, options_for_select(DirectoryListing::SORTS.invert, listing.sort), class: "type-input" %>
          </label>
          <button type="submit" class="nd-btn nd-btn--sm" data-filter-sheet-target="submit">Apply filters</button>
        <% end %>
        <p class="sr-only" role="status" data-filter-sheet-target="status"></p>
      </div>
      <dialog class="nd-filtersheet nd-filtersheet--modal" aria-labelledby="filters-title" data-filter-sheet-target="dialog"
              data-action="cancel->filter-sheet#close close->filter-sheet#closed"></dialog>
    </div>
  </div>

  <% if @fuzzy %><p class="nd-fuzzy-note type-small text-ink-muted">No exact match for “<%= listing.query %>”. Showing close names.</p><% end %>
  <%# The rows and Show more are one Turbo frame: Show more swaps the next page in
      place, so the page doesn't jump (advancing the address would scroll to the
      top). The link is still a real page (?shown=2) for crawlers and without
      JavaScript. Every other link in the frame (the company and plant rows)
      leaves it: target=_top, so only Show more loads into the frame. %>
  <turbo-frame id="directory-rows" target="_top" data-controller="keep-scroll">
  <% if total.zero? %>
    <% if listing.searching? %>
      <%= render "shared/empty_state", message: "No results for “#{listing.query}”#{" in #{list_page.name}" if list_page}.",
            action_label: "Clear search",
            action_url: directory_url_for(category: listing.category, tag: listing.tag&.key, technology: listing.technology, state: listing.state,
                                          role: listing.role, sort: (listing.sort unless listing.sort == DirectoryListing::DEFAULT_SORT)) %>
    <% elsif listing.filtered? %>
      <%= render "shared/empty_state", message: "Nothing matches these filters.", action_label: "Clear filters", action_url: directory_url_for(category: listing.category, tag: listing.tag&.key) %>
    <% else %>
      <%= render "shared/empty_state", message: list_page ? "Nothing verified here yet." : "No companies verified yet." %>
    <% end %>
  <% elsif listing.searching? && list_page.nil? %>
    <%# Search results are always grouped, so each row's type is announced. %>
    <% if @companies.any? %>
      <section aria-labelledby="companies-heading">
        <h2 id="companies-heading" class="nd-label mb-1">Companies</h2>
        <%= render "directory/company_lines", companies: @companies, short: @short %>
      </section>
    <% end %>
    <% if @plants.any? %>
      <section aria-labelledby="plants-heading">
        <h2 id="plants-heading" class="nd-label mb-1">Plants and sites</h2>
        <%= render "directory/plant_lines", plants: @plants %>
      </section>
    <% end %>
  <% else %>
    <% if @companies.any? %><%= render "directory/company_lines", companies: @companies, short: @short %><% end %>
    <% if @plants.any? %><%= render "directory/plant_lines", plants: @plants %><% end %>
  <% end %>
  <% if more %>
    <p class="mt-6"><%= link_to "Show more", directory_url_for(category: listing.category, q: listing.query, tag: listing.tag&.key, technology: listing.technology,
      state: listing.state, role: listing.role, sort: (listing.sort unless listing.sort == DirectoryListing::DEFAULT_SORT), shown: @shown / DirectoryController::PAGE + 1,
      from: ("suggestion" if listing.searching? && params[:from] == "suggestion")),
      class: "nd-btn nd-btn--outline type-ui", data: { turbo_frame: "directory-rows" } %></p>
  <% end %>
  </turbo-frame>
  <nav class="nd-quiet" aria-label="About this list">
    <%= link_to correction_url_for(listing.category&.plants ? "A missing plant" : "A missing company"), rel: "nofollow" do %><%= icon("flag", size: 16) %><%= listing.category&.plants ? "Missing a plant?" : "Missing a company?" %> Report a correction<% end %>
  </nav>
  </div>
  </div>
</main>
