<%# Instant results, loaded into the search box's frame. Links leave the frame
    (target _top) and go to the full page. %>
<turbo-frame id="<%= @frame_id %>" target="_top">
  <% if @query %>
    <% total = @companies.size + @plants.size %>
    <div class="nd-instant" data-instant-search-count="<%= total %>"<%= ' data-instant-search-fuzzy="true"'.html_safe if @fuzzy %>>
      <% if @fuzzy %><p class="nd-instant__note type-small">No exact match for “<%= @query %>”. Showing close names.</p><% end %>
      <% if @companies.any? %>
        <div class="nd-label nd-instant__group" id="<%= @frame_id %>-companies">Companies</div>
        <ul class="nd-instant__list" aria-labelledby="<%= @frame_id %>-companies">
          <% @companies.each do |company| %>
            <% role = @roles[company.id]&.map(&:role)&.find { |r| r.parent_id.nil? } || @roles[company.id]&.first&.role %>
            <% meta = [ (role_label(role) if role), place(company.hq_city, company.hq_state) ].compact.join(" · ").presence %>
            <li>
              <%= link_to company_url_for(company), class: "nd-instant__row" do %>
                <%= company_square(company, category: @categories[company.id]) %>
                <span class="nd-instant__text"><b class="type-body-strong"><%= company.name %></b><% if meta %><span class="type-small"><%= meta %></span><% end %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if @plants.any? %>
        <div class="nd-label nd-instant__group" id="<%= @frame_id %>-plants">Plants and sites</div>
        <ul class="nd-instant__list" aria-labelledby="<%= @frame_id %>-plants">
          <% @plants.each do |plant| %>
            <% meta = ([ facility_type_label(plant.facility_type), place(plant.city, plant.state) ].compact.join(" · ").presence if plant.verified?) %>
            <li>
              <%= link_to plant_url_for(plant), class: "nd-instant__row" do %>
                <span class="nd-catsq" aria-hidden="true"><%= icon(site_icon_name((plant.facility_type if plant.verified? && plant.try(:site_sourced)),
                      reactor_types: [ (plant.reactor_type if plant.verified? && plant.try(:site_sourced)), *plant.try(:units_reactor_types) ],
                      status: (plant.status if plant.verified? && plant.try(:site_sourced))), set: :nd, size: 20) %></span>
                <span class="nd-instant__text"><b class="type-body-strong"><%= plant.name %></b><% if meta %><span class="type-small"><%= meta %></span><% end %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
      <% if total.zero? %>
        <p class="nd-instant__empty type-body">No results for “<%= @query %>”. Check the spelling, or search a company or plant name.</p>
      <% else %>
        <%= link_to directory_url_for(q: @query), class: "nd-instant__all type-ui" do %>
          <span>All results for “<%= @query %>”</span><kbd class="type-data-sm">Enter</kbd>
        <% end %>
      <% end %>
    </div>
  <% end %>
</turbo-frame>
