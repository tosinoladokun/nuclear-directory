<%# Homepage B (#909): under the search, one link to the open data, then one large and two small chart cards (HomeCharts:
    a set from the pool of questions, one set a visit). Phones show the large card first. Locals: charts,
    [[question, data], ...] large first. %>
<p class="nd-home__download">
  <%= link_to data_path, class: "nd-home__downloadlink type-body", data: { home_download: true } do %><%= icon("download-simple", size: 16) %><span>Download the data</span><% end %>
</p>
<div class="nd-charts">
  <% charts.each_with_index do |(question, data), i| %>
    <%= render "home/chart_card", question:, data:, size: i.zero? ? :large : :small %>
  <% end %>
</div>
