<%# One chart card on homepage B (#909): the question as its title, then its chart. No subtitle and no source line: the
    page the title opens keeps the sources. The title row (the question and a small ↗) links to the operating plants
    list; rows and dots that are one record link to its page (#949), so the card itself isn't a link (links can't nest).
    The whole question shows on every card: two lines at most on a narrow one, never cut (#961). Locals: question
    (HomeCharts::Question), data, size: :large or :small. %>
<% title = format(question.question, count: data[:count]) %>
<div class="nd-chart nd-chart--<%= size %> nd-chart--<%= question.chart %>" data-home-chart="<%= question.key %>">
  <%= link_to directory_url_for(category: Category.find("plants"), status: "operating"), class: "nd-chart__head", data: { home_chart_link: true } do %>
    <h2 class="nd-chart__title type-title-md"><%= title %></h2>
    <span class="nd-chart__go"><%= icon("arrow-up-right", size: 16) %></span>
  <% end %>
  <div class="nd-chart__body"><%= render "home/charts/#{question.chart}", question:, data:, size: %></div>
</div>
