<%# One chart card on homepage B (#909): the question as its title, then its chart. No subtitle and no source line: the
    page the card opens keeps the sources. The whole card is one link; a small ↗ is its only sign. When the question
    won't fit the card on one line, the card shows its short title (a container query, so it follows the card's
    width, not the screen's). Locals: question (HomeCharts::Question), data, size: :large or :small. %>
<% title = format(question.question, count: data[:count]) %>
<% short = format(question.short, count: data[:count]) %>
<%= link_to directory_url_for(category: Category.find("plants"), status: "operating"), class: "nd-chart nd-chart--#{size} nd-chart--#{question.chart}", data: { home_chart: question.key } do %>
  <div class="nd-chart__head">
    <h2 class="nd-chart__title type-title-md"<% if short != title %> title="<%= title %>"<% end %>><% if short != title %><span class="nd-chart__tfull"><%= title %></span><span class="nd-chart__tshort"><%= short %></span><% else %><%= title %><% end %></h2>
    <span class="nd-chart__go"><%= icon("arrow-up-right", size: 16) %></span>
  </div>
  <div class="nd-chart__body"><%= render "home/charts/#{question.chart}", question:, data:, size: %></div>
<% end %>
