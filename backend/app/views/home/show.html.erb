<% content_for :title, "Nuclear Directory" %>
<%# Drawn without a visitor (PageWarmJob builds the cards in the background), the page is A. %>
<% home_variant = @home_variant || HomeVariant.new("A") %>
<% content_for :head do %>
  <meta name="description" content="Search the US nuclear industry: who makes the fuel, builds the reactors, runs the plants, buys the power and funds it.">
  <link rel="canonical" href="<%= root_url %>">
  <%# The A/B test's version (#909), added to the page view and the home events by analytics.js. %>
  <meta name="home-variant" content="<%= home_variant.name %>"<% if home_variant.forced? %> data-forced="true"<% end %>>
<% end %>
<%# The home page has the one-line footer: the wordmark above is enough, and the cards already list the directory. %>
<main class="nd-home">
  <h1 class="nd-home__wordmark"><span class="sr-only">Nuclear Directory</span><%= render "shared/site_icon" %><%= render "shared/wordmark" %></h1>

  <div class="nd-home__search">
    <%# The empty field opens Browse: the ten categories with their counts (#909). %>
    <%= render "shared/search_box", size: :large, browse: HomeCategories.browse %>
  </div>

  <% if @home_variant.b? %>
    <%= render "home/b", charts: @charts %>
  <% else %>
    <div class="nd-home__cats">
      <%# Built once per data version (PM, 2 Nov: speed). %>
      <% cache [ "home-cards/v2", DataVersion.current ] do %>
        <%= render "shared/category_cards", cards: HomeCategories.cards %>
      <% end %>
    </div>
  <% end %>
</main>
