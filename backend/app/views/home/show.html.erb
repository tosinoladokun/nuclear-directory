<% content_for :title, "Nuclear Directory" %>
<% content_for :head do %>
  <meta name="description" content="Search the US nuclear industry: who makes the fuel, builds the reactors, runs the plants, buys the power and funds it.">
  <link rel="canonical" href="<%= root_url %>">
<% end %>
<main class="nd-home">
  <h1 class="nd-home__wordmark"><span class="sr-only">Nuclear Directory</span><%= render "shared/wordmark" %></h1>

  <div class="nd-home__search">
    <%= render "shared/search_box", size: :large %>
    <nav class="nd-suggs" aria-label="Suggested searches">
      <%= link_to directory_url_for(q: "HALEU"), class: "nd-sugg type-ui" do %><%= icon("magnifying-glass", size: 12) %>HALEU<% end %>
      <%= link_to directory_url_for(q: "SMR"), class: "nd-sugg type-ui" do %><%= icon("magnifying-glass", size: 12) %>SMR<% end %>
      <%= link_to directory_url_for(q: "Vogtle"), class: "nd-sugg type-ui" do %><%= icon("magnifying-glass", size: 12) %>Plant Vogtle<% end %>
      <%= link_to directory_url_for(category: Category.find("power-buyers")), class: "nd-sugg type-ui" do %><%= icon("magnifying-glass", size: 12) %>Power deals<% end %>
    </nav>
  </div>

  <div class="nd-home__cats">
    <%= render "shared/category_boxes", examples: @examples, counts: @counts %>
  </div>
</main>
