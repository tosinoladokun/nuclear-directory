<% content_for :title, "Nuclear Directory" %>
<% content_for :head do %>
  <meta name="description" content="Search the US nuclear industry: who makes the fuel, builds the reactors, runs the plants, buys the power and funds it.">
  <link rel="canonical" href="<%= root_url %>">
<% end %>
<main class="nd-home">
  <h1 class="nd-home__wordmark"><span class="sr-only">Nuclear Directory</span><%= render "shared/wordmark" %></h1>

  <div class="nd-home__search">
    <%= render "shared/search_box", size: :large %>
    <nav class="nd-suggs" aria-label="Suggested searches" data-controller="fit-row" data-fit-row-minimum-value="<%= HomeSuggestions::MINIMUM %>">
      <% @suggestions.each do |suggestion| %>
        <%= link_to directory_url_for(q: suggestion.query, from: "suggestion"), class: "nd-sugg type-ui", data: { fit_row_target: "item" } do %><%= icon("magnifying-glass", size: 12) %><%= suggestion.label %><% end %>
      <% end %>
      <%# Hidden spares: shown only when the picked ones are too wide for MINIMUM pills. %>
      <% HomeSuggestions.spares(@suggestions).each do |suggestion| %>
        <%= link_to directory_url_for(q: suggestion.query, from: "suggestion"), class: "nd-sugg nd-sugg--spare type-ui", hidden: true, data: { fit_row_target: "item" } do %><%= icon("magnifying-glass", size: 12) %><%= suggestion.label %><% end %>
      <% end %>
    </nav>
  </div>

  <div class="nd-home__cats">
    <%= render "shared/category_cards", cards: @cards %>
  </div>
</main>
