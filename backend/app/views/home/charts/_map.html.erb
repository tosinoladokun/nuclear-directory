<%# The operating plants on a map of the contiguous states (#909): one dot per plant, in the power plants' colour.
    Dots: { name:, state:, x:, y: } in HomeMap's 600 by 370 box; plants on one spot share a dot.
    Hovering, focusing or tapping a dot shows its name and state above it (#940); a dot is not a link, so clicking it
    doesn't open the card's page. %>
<div class="nd-chartmap-wrap" data-controller="home-map" data-action="pointerdown->home-map#down click->home-map#click pointerover->home-map#over pointerout->home-map#out focusin->home-map#focus focusout->home-map#blur keydown.esc->home-map#hide">
  <svg class="nd-chartmap" viewBox="0 0 <%= HomeMap::WIDTH %> <%= HomeMap::HEIGHT %>" role="group" aria-label="Map of the <%= data[:count] %> operating US nuclear plants" xmlns="http://www.w3.org/2000/svg" data-home-map-target="svg">
    <%= render "home/charts/us_outline" %>
    <g class="nd-chartmap__dots">
      <% data[:dots].each do |dot| %><circle class="nd-chartmap__dot" cx="<%= dot[:x] %>" cy="<%= dot[:y] %>" r="7" tabindex="0" role="img" aria-label="<%= [ dot[:name], dot[:state] ].compact.join(", ") %>" data-name="<%= dot[:name] %>"<% if dot[:state] %> data-state="<%= dot[:state] %>"<% end %>></circle><% end %>
    </g>
  </svg>
  <div class="nd-chartmap__label" data-home-map-target="label" aria-hidden="true" hidden>
    <span class="nd-chartmap__name type-ui" data-home-map-target="name"></span>
    <span class="nd-chartmap__state type-small" data-home-map-target="state"></span>
  </div>
</div>
