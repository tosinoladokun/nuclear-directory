<% labels = { "mining" => "Mining", "conversion" => "Conversion", "enrichment" => "Enrichment", "fabrication" => "Fuel fabrication" } %>
<%= render layout: "home/chart_card", locals: { key: "fuel", size:, url: directory_url_for(category: Category.find("fuel")),
      title: "Where US reactor fuel comes from", subtitle: "Companies at each step, from the uranium mine to the fuel plant.",
      sources: chart_sources(data[:sources]), link: "Fuel and materials" } do %>
  <ol class="nd-chart__chain">
    <% data[:steps].each do |step| %>
      <li class="nd-chart__step">
        <span class="nd-chart__steplabel nd-label"><%= labels.fetch(step[:step]) %> <span class="type-data-sm"><%= step[:count] %></span></span>
        <ul class="nd-chart__names">
          <% step[:companies].each do |row| %>
            <li class="nd-chart__name type-small" title="<%= row[:name] %>"><%= row[:short].presence && row[:name].length > 22 ? row[:short] : row[:name] %></li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ol>
<% end %>
