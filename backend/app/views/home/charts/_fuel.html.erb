<% labels = { "mining" => "Mining", "conversion" => "Conversion", "enrichment" => "Enrichment", "fabrication" => "Fuel fabrication" } %>
<%= render layout: "home/chart_card", locals: { key: "fuel", size:, url: directory_url_for(category: Category.find("fuel")),
      title: "Where US reactor fuel comes from", short_title: "Where US fuel comes from",
      subtitle: "Companies at each step, from the uranium mine to the fuel plant.",
      sources: chart_sources(data[:sources], limit: size == :large ? 3 : 2), link: "Fuel and materials" } do %>
  <%# One step per row, the names as chips that wrap: a name is never cut (Design, #920). %>
  <ol class="nd-chart__chain">
    <% data[:steps].each_with_index do |step, i| %>
      <li class="nd-chart__step">
        <span class="nd-chart__steplabel nd-label"><% if i.positive? %><span class="nd-chart__arrow" aria-hidden="true"><%= icon("arrow-right", size: 12) %></span><% end %><%= labels.fetch(step[:step]) %> <span class="type-data-sm"><%= step[:count] %></span></span>
        <ul class="nd-chart__names">
          <% step[:companies].each do |row| %>
            <%# One chip size in a row (Design, #920): the full name at 15px, its short name only past 31 characters. %>
            <li class="nd-chart__name" title="<%= row[:name] %>"><%= line_name(row[:name], row[:short]).first %></li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ol>
<% end %>
