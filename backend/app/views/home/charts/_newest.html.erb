<%= render layout: "home/chart_card", locals: { key: "newest", size:, url: updates_path,
      title: "Newest in the directory", subtitle: "The latest facts added, each with its source.",
      sources: "Source: What's new", link: "What's new" } do %>
  <ul class="nd-chart__news">
    <% data.each do |row| %>
      <li class="nd-chart__newsrow">
        <span class="nd-chart__newstitle type-small" title="<%= row[:title] %>"><%= row[:title] %></span>
        <span class="nd-chart__newsmeta type-data-sm"><%= l(row[:date], format: "%-d %b") %><% if row[:domain] %> · <%= row[:domain] %><% end %></span>
      </li>
    <% end %>
  </ul>
<% end %>
