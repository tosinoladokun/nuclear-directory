<%
  p = @profile
  role_tags = p.shown_roles.map { |r| role_label(r.role) }
  tech_tags = p.technologies.map { |t| t.technology.name }
  record_citations = p.citations_for(p.organization)
  # Several names read as one line, shrunk to fit (the glance panel).
  name_list = ->(names) { names.join(", ").presence }
  # Title and description say what this page adds, from published facts (#292).
  content_for :title, company_title(p)
  content_for :og_title, p.name
  @link_card = [ LinkCard.for_company(p), "companies", p.slug ] # its preview image (#245)
  description = company_description(p)
  content_for :og_description, description
%>
<% content_for :head do %>
  <meta name="description" content="<%= description %>">
  <link rel="canonical" href="<%= company_url(slug: p.slug) %>">
<% end %>
<%= render "shared/site_header" %>

<main class="nd-page nd-page--company">
  <%# In the body, not the head: Turbo keeps head scripts from earlier pages, which would pile up one graph per profile visited. %>
  <%= json_ld_tag(company_json_ld(p, page_url: company_url(slug: p.slug))) %>
  <nav class="nd-crumbs" aria-label="Breadcrumb">
    <% if p.category %><%= link_to p.category.name, directory_url_for(category: p.category), class: "nd-link nd-link--muted" %> / <% end %><span aria-current="page"><%= p.name %></span>
  </nav>

  <%
    index = [ { label: "Overview", href: "#overview", current: true } ]
    index << { label: "Deals and links", href: "#deals", count: p.deals.size } if p.deals.any?
    index << { label: "Plants and sites", href: "#plants", count: p.plant_links.size } if p.plant_links.any?
    index << { label: "Sources", href: "#sources", count: p.citations.sources.size } if p.citations.sources.any?
    plant_roles = p.plant_links.map(&:relationship_type).uniq
    plant_role = ("as #{facility_role_noun(plant_roles.first)}" if plant_roles.one?)
    cite_text = "Nuclear Directory. “#{p.name}.” #{company_url(slug: p.slug)}. Accessed #{Date.current.strftime("%-d %B %Y")}."
    facts = [
      { label: "Type", value: (tag.span(class: "nd-chips") { safe_join(p.buckets.map { |b| render("shared/chip", label: b.name, href: directory_url_for(category: b), icon: bucket_icon(b), bucket: b) }) } if p.buckets.any?) },
      { label: role_tags.size > 1 ? "Roles" : "Role", value: name_list.(role_tags), wide: role_tags.size > 1 },
      { label: "Technology", value: name_list.(tech_tags), wide: tech_tags.size > 1 },
      { label: "Headquarters", value: location(p.hq_city, p.hq_state, country: p.organization.country_code) },
      { label: "Website", value: (link_to(p.website.sub(%r{\Ahttps?://(www\.)?}, "").chomp("/"), with_referral_utm(p.website, campaign: "company-page"), class: "nd-link", rel: "noopener noreferrer", target: "_blank") if p.website.present? && p.website.match?(%r{\Ahttps?://}i)) },
      { label: p.parents.size > 1 ? "Parent companies" : "Parent company", wide: p.parents.size > 1,
        value: (safe_join(p.parents.map { |l| link_to(l.to_organization.name, company_url_for(l.to_organization), class: "nd-link") }, ", ") if p.parents.any?) },
      { label: "Subsidiaries", wide: true, value: (safe_join(p.subsidiaries.map { |l| link_to(l.from_organization.name, company_url_for(l.from_organization), class: "nd-link") }, ", ") if p.subsidiaries.any?) },
      { label: "Also known as", value: name_list.(p.aliases), wide: p.aliases.size > 1 },
      { label: "Legal name", value: p.legal_name, wide: true },
      { label: "Founded", value: p.founded_year }
    ]
  %>
  <div class="nd-company" data-controller="section-index">
    <div class="nd-company__index"><%= render "shared/index", items: index, label: "On this page" %></div>

    <div class="nd-company__head" id="overview">
      <%= render "shared/page_head", name: p.name, about: p.description, tags: role_tags + tech_tags %>
    </div>

    <div class="nd-company__glance"><%= render "shared/glance", facts: %></div>

    <div class="nd-company__main nd-secs">
      <% if p.deals.any? %>
        <section aria-labelledby="deals-heading" id="deals">
          <%= render "shared/section_head", title: "Deals and links", count: p.deals.size, id: "deals-heading" %>
          <%= render "companies/crows", label: "deals", rows: p.deals.map { |deal| render("companies/deal_row", deal:, profile: p) } %>
        </section>
      <% end %>

      <% if p.plant_links.any? %>
        <section aria-labelledby="plants-heading" id="plants">
          <h2 id="plants-heading" class="nd-sechead type-section-title">Plants and sites<span class="nd-sechead__count"><%= p.plant_links.size %></span><% if plant_role %><span class="nd-sechead__note">· <%= plant_role %></span><% end %></h2>
          <%= render "companies/crows", label: "plants and sites",
                rows: p.plant_links.map { |link| render("companies/plant_link_row", link:, profile: p, role: (facility_role_noun(link.relationship_type) unless plant_role)) } %>
        </section>
      <% end %>
    </div>

    <div class="nd-company__end" data-controller="quiet">
      <nav class="nd-quiet" aria-label="About this page">
        <% if p.citations.sources.any? %>
          <button type="button" aria-expanded="false" aria-controls="sources" data-action="quiet#toggle" data-quiet-target="button" data-panel="sources"><%= icon("link", size: 16) %><b class="nd-num"><%= p.citations.sources.size %></b> <%= "source".pluralize(p.citations.sources.size) %></button>
        <% end %>
        <button type="button" aria-expanded="false" aria-controls="cite" data-action="quiet#toggle" data-quiet-target="button" data-panel="cite"><%= icon("info", size: 16) %>Cite this page</button>
        <%= link_to correction_url_for(p.name) do %><%= icon("flag", size: 16) %>Report a correction<% end %>
      </nav>
      <% if p.citations.sources.any? %>
        <div class="nd-quietpanel"><%= render "shared/sources_list", sources: p.citations.sources, hidden: true %></div>
      <% end %>
      <div class="nd-quietpanel" id="cite" hidden data-quiet-target="panel"><%= render "shared/cite_panel", text: cite_text %></div>
    </div>
  </div>
</main>
