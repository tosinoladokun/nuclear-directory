<%# One deal on a company page, on one line (#556): the other company's category square, its name and
    the link verb, the short "what" when stored data gives one, the date, a source mark and a chevron.
    The row opens (a button) to the full description, the quote, the source and the confidence.
    Locals: deal, profile. %>
<% other = profile.other_party(deal) %>
<% from_us = deal.from_organization_id == profile.organization.id %>
<% verb = relationship_verb(deal.relationship_type) %>
<% who = from_us ? [ profile.name, " #{verb} ", other.name ] : [ other.name, " #{verb} ", profile.name ] %>
<% what = profile.deal_line(deal) %>
<% date = profile.deal_date(deal) %>
<% evidence = deal.evidence.max_by { |e| e.confidence || 0 } %>
<% citations = profile.citations_for(deal) %>
<% quote = evidence&.quote %>
<% detail_id = "deal-#{deal.id}" %>
<li class="nd-crow" data-controller="row-open">
  <button type="button" class="nd-crow__line" aria-expanded="false" aria-controls="<%= detail_id %>" data-action="row-open#toggle" data-row-open-target="button">
    <%= company_square(other) %>
    <%# One line on desktop (name and verb); on phones the other company's name sits alone on line 1 and the rest on line 2. %>
    <span class="nd-crow__who" title="<%= who.join %>">
      <% if from_us %><span class="nd-crow__rest"><span class="nd-crow__us"><%= profile.name %> </span><%= verb %> </span><b class="nd-crow__name"><%= other.name %></b>
      <% else %><b class="nd-crow__name"><%= other.name %></b><span class="nd-crow__rest"> <%= verb %><span class="nd-crow__us"> <%= profile.name %></span></span><% end %>
    </span>
    <% if what.present? %><span class="nd-crow__what" title="<%= what %>"><%= what %></span><% end %>
    <% if date %><time class="nd-crow__date" datetime="<%= date.iso8601 %>"><%= date.strftime("%b %Y") %></time><% end %>
  </button>
  <%= render "shared/source_mark", citations: %>
  <span class="nd-crow__chev" aria-hidden="true"><%= icon("caret-down", size: 16) %></span>
  <div class="nd-crow__more" id="<%= detail_id %>" hidden data-row-open-target="panel">
    <% if deal.description.present? %><p class="type-body"><%= deal.description %></p><% end %>
    <% fields = data_quote_fields(evidence) %>
    <% if fields %>
      <p class="nd-quote nd-quote--data" data-source-number="<%= citations.first&.first %>"><%= fields.join(" · ") %></p>
    <% elsif quote.present? %>
      <p class="nd-quote" data-source-number="<%= citations.first&.first %>">“<%= quote %>”</p>
    <% end %>
    <div class="nd-row">
      <% citations.each_with_index do |(number, source), index| %><%= render "shared/source_chip", number:, source:, checked: (deal.verified_at if index.zero?) %><% end %>
      <%= render "shared/confidence", value: deal.confidence %>
    </div>
  </div>
</li>
