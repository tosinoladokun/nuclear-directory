<%
  s = @suggestions
  content_for :title, "Page not found · Nuclear Directory"
%>
<% content_for :head do %><meta name="robots" content="noindex"><% end %>
<%= render "shared/site_header" %>

<main class="nd-page nd-page--narrow nd-notfound">
  <p class="nd-notfound__numeral type-numeral" aria-hidden="true">404</p>

  <section class="nd-notfound__lead" aria-labelledby="notfound-heading">
    <p class="type-data-sm text-ink-muted">404 · Not in the directory</p>
    <h1 id="notfound-heading" class="type-title-md">We don't have a page at this address.</h1>
    <p class="nd-notfound__path type-data"><%= @path %></p>
  </section>

  <% if s.matches.any? %>
    <section aria-labelledby="notfound-matches">
      <h2 id="notfound-matches" class="nd-sec-h">Did you mean</h2>
      <ul class="nd-lines">
        <% s.matches.each do |kind, record| %>
          <% if kind == :company %>
            <%= render "shared/line", variant: :bare, href: company_url_for(record), name: record.name, short_name: record.short_name, place: location(record.hq_city, record.hq_state, country: record.country_code) %>
          <% else %>
            <%= render "shared/line", href: plant_url_for(record), name: record.name, mark: icon("site-plant", set: :nd, size: 20),
                  what: (facility_type_label(record.facility_type) if record.verified?), place: (location(record.city, record.state) if record.verified?) %>
          <% end %>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="nd-notfound__search" aria-labelledby="notfound-search">
    <h2 id="notfound-search" class="nd-sec-h">Search the directory</h2>
    <%= render "shared/search_box", size: :large, query: s.query, id: "search-notfound" %>
    <p class="type-small text-ink-muted">Or <%= link_to "go to the home page", "/", class: "nd-link" %>.</p>
  </section>
</main>
